#!/bin/sh
set -e

# ubturbo-rmrs postrm -- remove user/group and runtime state on purge.
# Mirrors RPM spec %postun rmrs.

case "$1" in
    purge)
        # Remove system user and group.
        if id ubturbo >/dev/null 2>&1; then
            userdel -r ubturbo 2>/dev/null || true
        fi
        if getent group ubturbo >/dev/null 2>&1; then
            groupdel ubturbo 2>/dev/null || true
        fi

        # Remove runtime state (log dir, sudoers fragment). Also drop
        # the legacy /opt/ubturbo directory from pre-FHS installs.
        # Everything under /usr and /etc/ubturbo is owned by dpkg and
        # removed automatically.
        rm -rf /var/log/ubturbo /opt/ubturbo
        rm -f /etc/sudoers.d/ubturbo
        ;;
esac

#DEBHELPER#

exit 0

 plugins/smap/test/depends/include/linux/mm.h  |   2 +-
 .../smap/test/drivers/test_accessed_bit.cpp   | 774 +++++++++++++++++-
 3 files changed, 777 insertions(+), 3 deletions(-)

diff --git a/plugins/smap/test/depends/arch/arm64/mm/stub.c b/plugins/smap/test/depends/arch/arm64/mm/stub.c

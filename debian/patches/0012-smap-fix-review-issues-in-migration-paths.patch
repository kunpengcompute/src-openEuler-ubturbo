--- a/plugins/smap/src/tiering/ham_migration.c
+++ b/plugins/smap/src/tiering/ham_migration.c
@@ -960,7 +960,7 @@ static long ioctl_migration_pages(unsigned long arg)
 						  HAM_TASK_ALLOW_MIGR);

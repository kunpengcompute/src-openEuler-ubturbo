     if (memSize > curMemSize) {
@@ -2840,7 +2844,12 @@ static int SmapMigratePidRemoteNumaCheck(struct MigrateEscapeMsg *msg)
         }
         if (msg->payload[i].migrateMode == MIG_MEMSIZE_MODE) {
             if (msg->payload[i].memSize == 0) {

From a5e11c4b8c5c130ae8632a2edb5bbcc6a0df2a70 Mon Sep 17 00:00:00 2001
From: lucas <1358497393@qq.com>
Date: Thu, 2 Jul 2026 10:36:32 +0800
Subject: [PATCH 11/43] fix(smap): synchronously update destination
 access_bit_actc_data value during migration

---
 plugins/smap/src/drivers/access_mmu.c         |  2 +-
 plugins/smap/src/drivers/access_mmu.h         |  2 +-
 plugins/smap/src/drivers/access_tracking.c    | 29 +++++++++++++++++++
 plugins/smap/src/drivers/access_tracking.h    |  1 +
 plugins/smap/src/tiering/smap_migrate_pages.c |  8 ++---
 plugins/smap/src/tiering/smap_migrate_pages.h |  1 +
 6 files changed, 37 insertions(+), 6 deletions(-)

diff --git a/plugins/smap/src/drivers/access_mmu.c b/plugins/smap/src/drivers/access_mmu.c
index 92a520c..5384fc4 100644
--- a/plugins/smap/src/drivers/access_mmu.c
+++ b/plugins/smap/src/drivers/access_mmu.c
@@ -62,7 +62,7 @@ static inline pagemap_entry_t make_pme(u64 frame, u64 flags)
 	return (pagemap_entry_t){ .pme = (frame & PM_PFRAME_MASK) | flags };
 }
 
-static int calc_paddr_acidx(u64 paddr, int *nid, u64 *index)
+int calc_paddr_acidx(u64 paddr, int *nid, u64 *index)
 {
 	int page_size = is_access_hugepage() ? g_pagesize_huge : PAGE_SIZE;
 	if (is_paddr_local(paddr))
diff --git a/plugins/smap/src/drivers/access_mmu.h b/plugins/smap/src/drivers/access_mmu.h
index babad13..e24ff8a 100644
--- a/plugins/smap/src/drivers/access_mmu.h
+++ b/plugins/smap/src/drivers/access_mmu.h
@@ -15,7 +15,7 @@ extern rwlock_t rem_ram_list_lock;
 
 void walk_pid_pagemap(struct pagemapread *pm);
 struct mm_struct *get_mm_by_pid(pid_t pid);
-
+int calc_paddr_acidx(u64 paddr, int *nid, u64 *index);
 int add_to_bm_hugepage(u64 vaddr, u64 paddr, struct access_pid *ap);
 int add_to_bm_page(u64 paddr, struct access_pid *ap);
 int add_to_bm_page_fast(u64 paddr, int nid, u64 acidx, struct access_pid *ap);
diff --git a/plugins/smap/src/drivers/access_tracking.c b/plugins/smap/src/drivers/access_tracking.c
index 517ed23..c0de0b5 100644
--- a/plugins/smap/src/drivers/access_tracking.c
+++ b/plugins/smap/src/drivers/access_tracking.c
@@ -31,6 +31,8 @@
 #include "accessed_bit.h"
 #include "access_pid.h"
 #include "hist_ops.h"
+#include "access_mmu.h"
+#include "smap_page_flags.h"
 #include "access_tracking.h"
 #include "smap_cold_queue.h"
 
@@ -65,6 +67,33 @@ u8 access_page_size = PAGE_MODE_2M;
 u32 g_pagesize_huge;
 EXPORT_SYMBOL(g_pagesize_huge);
 
+void migrate_folio_actc(struct folio *folio_from, struct folio *folio_to)
+{
+	if (!folio_from || !folio_to) {
+		return;
+	}
+	int nid_from, nid_to;
+	u64 index_from, index_to;
+	struct access_tracking_dev *adev_from, *adev_to;
+
+	calc_paddr_acidx(PFN_PHYS(folio_pfn(folio_from)), &nid_from, &index_from);
+	calc_paddr_acidx(PFN_PHYS(folio_pfn(folio_to)), &nid_to, &index_to);
+
+	adev_from = get_access_tracking_dev(folio_nid(folio_from));
+	adev_to = get_access_tracking_dev(folio_nid(folio_to));
+
+	if (unlikely(!adev_from || !adev_to)) {
+		return;
+	}
+	if (unlikely(index_from >= adev_from->page_count || index_to >= adev_to->page_count)) {
+		return;
+	}
+
+	adev_to->access_bit_actc_data[index_to] = smap_acc_cnt_get(&folio_from->page);
+	adev_from->access_bit_actc_data[index_from] = 0;
+}
+EXPORT_SYMBOL(migrate_folio_actc);
+
 ktime_t calc_time_us(ktime_t start_time)
 {
 	ktime_t cur_time, time_us;
diff --git a/plugins/smap/src/drivers/access_tracking.h b/plugins/smap/src/drivers/access_tracking.h
index 986cef6..0ad8785 100644
--- a/plugins/smap/src/drivers/access_tracking.h
+++ b/plugins/smap/src/drivers/access_tracking.h
@@ -83,4 +83,5 @@ static inline int get_page_size(struct access_tracking_dev *adev)
 void cancel_ap_scan_work(struct access_pid *ap);
 void submit_one_work(struct access_pid *ap);
 ktime_t calc_time_us(ktime_t start_time);
+void migrate_folio_actc(struct folio *folio_from, struct folio *folio_to);
 #endif /* _SRC_ACCESS_TRACKING_H */
diff --git a/plugins/smap/src/tiering/smap_migrate_pages.c b/plugins/smap/src/tiering/smap_migrate_pages.c
index dbcfb0c..8204623 100644
--- a/plugins/smap/src/tiering/smap_migrate_pages.c
+++ b/plugins/smap/src/tiering/smap_migrate_pages.c
@@ -1148,10 +1148,10 @@ struct folio *smap_alloc_huge_page_node(struct folio *folio, int nid,
 
 struct folio *smap_alloc_new_node_page(struct folio *folio, unsigned long node)
 {
-	if (folio_test_hugetlb(folio)) {
-		return smap_alloc_huge_page_node(folio, node, false);
-	}
-	return alloc_demote_page(folio, node);
+	struct folio *dst_folio;
+	dst_folio = folio_test_hugetlb(folio) ? smap_alloc_huge_page_node(folio, node, false) : alloc_demote_page(folio, node);
+	migrate_folio_actc(folio, dst_folio);
+	return dst_folio;
 }
 
 struct folio *smap_alloc_new_node_page_mig_back(struct folio *folio,
diff --git a/plugins/smap/src/tiering/smap_migrate_pages.h b/plugins/smap/src/tiering/smap_migrate_pages.h
index 9507d0d..f231a02 100644
--- a/plugins/smap/src/tiering/smap_migrate_pages.h
+++ b/plugins/smap/src/tiering/smap_migrate_pages.h
@@ -16,6 +16,7 @@
 extern int nr_local_numa;
 extern int isolate_lru_page(struct page *page);
 extern ktime_t calc_time_us(ktime_t start_time);
+extern void migrate_folio_actc(struct folio *folio_from, struct folio *folio_to);
 
 enum smap_migrate_type {
 	MIGRATE_TYPE_HOTNESS,
-- 

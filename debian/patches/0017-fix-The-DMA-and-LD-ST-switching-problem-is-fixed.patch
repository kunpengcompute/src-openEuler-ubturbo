Subject: [PATCH 17/71] fix:The DMA and LD/ST switching problem is fixed

---
 plugins/smap/src/tiering/smap_migrate_pages.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/plugins/smap/src/tiering/smap_migrate_pages.c b/plugins/smap/src/tiering/smap_migrate_pages.c
index 28ceb79..030e484 100644
--- a/plugins/smap/src/tiering/smap_migrate_pages.c
+++ b/plugins/smap/src/tiering/smap_migrate_pages.c
@@ -73,6 +73,8 @@ void set_remote_migrate_mode(unsigned int mode)
 {
 	if (mode) {
 		remote_migrate_mode = MIGRATE_ASYNC_DMA_OFFLOADING;
+	} else {
+		remote_migrate_mode = MIGRATE_ASYNC;
 	}
 	pr_info("set remote migrate mode: %u\n", remote_migrate_mode);
 }

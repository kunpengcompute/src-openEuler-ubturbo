+static void actc_data_add_fast(phys_addr_t paddr, u32 page_size,
+			       struct access_pid *ap)
+{
+	struct access_tracking_dev *adev;
+	int ret, nid;
+	u64 pa_index;
+
+	nid = get_numa_id_by_paddr(paddr);
+	if (unlikely(nid == NUMA_NO_NODE))
+		return;
+
+	if (nid < nr_local_numa) {
+		ret = calc_paddr_acidx_acpi_known_nid(paddr, nid, &pa_index,
+						      page_size);
+	} else {
+		ret = calc_paddr_acidx_iomem_known_nid(paddr, nid, &pa_index,
+						       page_size);
+	}
+
+	if (unlikely(ret))
+		return;
+
+	adev = get_access_tracking_dev(nid);
+	if (unlikely(!adev || pa_index >= adev->page_count || adev->is_hist))
+		return;
+
+	struct page *page = pfn_to_online_page(PHYS_PFN(paddr));
+	if (!page)
+		return;
+	if (smap_page_init(page)) {
+		smap_page_mark(page);
+		/* New pages: use per-PID cached mean value */
+		adev->access_bit_actc_data[pa_index] = ap->actc_mean_value;
+	} else {
+		adev->access_bit_actc_data[pa_index]++;
+		if (adev->access_bit_actc_data[pa_index] >= ACTC_MAX) {
+			ap->decay_flag = true;
+		}
+	}
+}

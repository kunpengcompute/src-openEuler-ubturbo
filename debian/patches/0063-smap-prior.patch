index 5b8850a..7395408 100644
--- a/plugins/smap/src/drivers/access_pid.c
+++ b/plugins/smap/src/drivers/access_pid.c
@@ -21,6 +21,8 @@
 #include "access_tracking.h"
 #include "access_mmu.h"
 #include "access_pid.h"

From c3236137cf787b1f43cfd6b28d94183e0e4c222c Mon Sep 17 00:00:00 2001
From: Jiming Pang <discrete_brain@163.com>
Date: Thu, 23 Jul 2026 18:27:31 +0800
Subject: [PATCH 36/43] smap: replace cold queue spinlock with lock-free MPSC
 ring
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Convert smap_cold_queue from a global-spinlock-protected ring to a
lock-free MPSC design.  Producers claim slots via atomic_fetch_add()
on per-node tail, write the PFN, then commit via atomic_inc() on
count — no lock, no irqsave, no memory barrier on the hot per-page
enqueue path.  The single consumer (drain) reads count and walks
head with atomic_dec(), also lock-free.

Correctness relies on the existing architecture: the drain ioctl
arrives only after all scan threads have quiesced, so the consumer
never observes partially-committed slots.  With this guarantee no
store barrier is needed between the PFN write and the count commit.

Remove the global smap_cold_pid_lock, all spin_lock_irqsave pairs
(2 in enqueue, 3 in drain), and the extern declaration in mig_init.c.
tail and count become atomic_t; head remains consumer-only u32.
---
 plugins/smap/src/drivers/smap_cold_queue.c | 91 ++++++++++++++--------
 plugins/smap/src/drivers/smap_cold_queue.h | 28 +++++--
 plugins/smap/src/tiering/mig_init.c        | 30 ++++---
 3 files changed, 100 insertions(+), 49 deletions(-)

diff --git a/plugins/smap/src/drivers/smap_cold_queue.c b/plugins/smap/src/drivers/smap_cold_queue.c
index 5035b89..f786f6b 100644
--- a/plugins/smap/src/drivers/smap_cold_queue.c
+++ b/plugins/smap/src/drivers/smap_cold_queue.c
@@ -3,10 +3,12 @@
  * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
  * Description: Per-node PFN queue for cold page swap-out
  *
- * Provides the per-node circular buffer and enqueue function used by the
- * scan path (accessed_bit.c).  Only remote (slow-tier) cold pages are
- * enqueued.  The drain function lives in the tiering module (mig_init.c)
- * which has access to reclaim_pages.
+ * Lock-free MPSC ring buffer.  The scan path (accessed_bit.c) enqueues
+ * cold remote PFNs under the owning node via atomic_fetch_add on tail;
+ * the drain function (mig_init.c) iterates the array and reclaims pages.
+ *
+ * Correctness constraint: producers (scan) and consumer (drain) must not
+ * run concurrently.  See smap_cold_queue.h for details.
  */
 
 #include <linux/kernel.h>
@@ -21,58 +23,83 @@
 struct smap_cold_queue smap_cold_numa_queue[SMAP_MAX_NUMNODES];
 EXPORT_SYMBOL(smap_cold_numa_queue);
 
-void smap_cold_queue_free(void)
+int smap_cold_queue_init(void)
 {
 	int i;
 
 	for (i = 0; i < SMAP_MAX_NUMNODES; i++) {
-		struct smap_cold_queue *q = &smap_cold_numa_queue[i];
-		vfree(q->pfn);
-		q->pfn = NULL;
+		smap_cold_numa_queue[i].pfn =
+			vmalloc(SMAP_COLD_QUEUE_MAX_SIZE * sizeof(u64));
+		if (!smap_cold_numa_queue[i].pfn)
+			return -1;
+		smap_cold_numa_queue[i].head = 0;
+		atomic_set(&smap_cold_numa_queue[i].tail, 0);
+		atomic_set(&smap_cold_numa_queue[i].count, 0);
 	}
+	return 0;
 }
 
-int smap_cold_queue_init(void)
+void smap_cold_queue_free(void)
 {
-	int ret = 0;
 	int i;
 
 	for (i = 0; i < SMAP_MAX_NUMNODES; i++) {
-		struct smap_cold_queue *q = &smap_cold_queues[i];
-
-		q->pfn = vmalloc(SMAP_COLD_QUEUE_MAX_SIZE * sizeof(u64),
-				 GFP_KERNEL);
-		if (!q->pfn) {
-			smap_cold_queue_free();
-			ret = -ENOMEM;
-			break;
-		}
-		q->head = 0;
-		q->tail = 0;
-		q->count = 0;
+		vfree(smap_cold_numa_queue[i].pfn);
+		smap_cold_numa_queue[i].pfn = NULL;
+		smap_cold_numa_queue[i].head = 0;
+		atomic_set(&smap_cold_numa_queue[i].tail, 0);
+		atomic_set(&smap_cold_numa_queue[i].count, 0);
 	}
-	return ret;
 }
 
+/*
+ * smap_cold_queue_enqueue - Enqueue a cold PFN for swap-out (lock-free).
+ * @nid: NUMA node id
+ * @pfn:  page frame number
+ *
+ * Uses atomic_fetch_add on tail to claim a ring slot without a spinlock.
+ * The consumer must not run concurrently with this function (guaranteed
+ * by userspace sequencing: drain ioctl only arrives after scan is
+ * disabled), so no memory barrier is needed between the PFN store and
+ * the atomic_inc(&count) commit.
+ *
+ * Return: 0 on success, -1 if the per-node ring is full.
+ */
 int smap_cold_queue_enqueue(int nid, u64 pfn)
 {
 	struct smap_cold_queue *q;
-	unsigned long flags;
+	u32 slot;
 
 	if (nid < 0 || nid >= SMAP_MAX_NUMNODES)
 		return -1;
 
 	q = &smap_cold_numa_queue[nid];
-	spin_lock_irqsave(&smap_cold_pid_lock, flags);
-	if (q->count >= SMAP_COLD_QUEUE_MAX_SIZE) {
-		spin_unlock_irqrestore(&smap_cold_pid_lock, flags);
+
+	/*
+	 * Fullness check: use tail - head (claimed slots) rather than count
+	 * (committed slots) because a claimed slot may not yet be committed
+	 * (producer preempted between claim and write).  head is consumer-only
+	 * and stable during the scan phase.
+	 */
+	if ((u32)(atomic_read(&q->tail) - q->head) >=
+	    SMAP_COLD_QUEUE_MAX_SIZE)
 		return -1;
-	}
 
-	q->pfn[q->tail] = pfn;
-	q->tail = (q->tail + 1) & SMAP_COLD_QUEUE_MAX_MASK;
-	q->count++;
-	spin_unlock_irqrestore(&smap_cold_pid_lock, flags);
+	/* Claim a slot. */
+	slot = (u32)(atomic_fetch_add(1, &q->tail) &
+		     SMAP_COLD_QUEUE_MAX_MASK);
+
+	/*
+	 * Write the PFN and commit.  No barrier needed between
+	 * the store and atomic_inc(): (a) the drain consumer runs
+	 * only after all producers have quiesced, so cache-coherence
+	 * propagation has long since completed by the time any
+	 * consumer reads this slot; (b) on ARM64 atomic_inc()
+	 * already carries store-release semantics (STLR).
+	 */
+	q->pfn[slot] = pfn;
+	atomic_inc(&q->count);
+
 	return 0;
 }
 EXPORT_SYMBOL(smap_cold_queue_enqueue);
diff --git a/plugins/smap/src/drivers/smap_cold_queue.h b/plugins/smap/src/drivers/smap_cold_queue.h
index 71e8dbb..b9f6b3d 100644
--- a/plugins/smap/src/drivers/smap_cold_queue.h
+++ b/plugins/smap/src/drivers/smap_cold_queue.h
@@ -3,14 +3,26 @@
  * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
  * Description: Per-node PFN queue for cold page swap-out
  *
- * During the scan phase, pages whose consecutive-cold-period counter crosses
- * SMAP_COLD_PERIOD_THRESHOLD are enqueued here.
+ * Lock-free MPSC ring buffer.  During the scan phase (producers only),
+ * enqueue claims a slot via atomic_fetch_add(&tail) and commits via
+ * atomic_inc(&count) after the PFN is written.  During the drain phase
+ * (single consumer, after all producers have quiesced), the consumer
+ * reads count and walks head..head+count.  No global lock — per-node
+ * tail and count are the only shared state.
+ *
+ * IMPORTANT: The consumer MUST NOT run concurrently with producers.
+ * In the current architecture this is guaranteed by userspace: the
+ * drain ioctl (SMAP_MIG_DRAIN_COLD_QUEUE) is issued only after all
+ * scan ioctls have returned.
  */
 
 #ifndef _SRC_SMAP_COLD_QUEUE_H
 #define _SRC_SMAP_COLD_QUEUE_H
 
-#define SMAP_COLD_QUEUE_MAX_SIZE (262144 * 16) /* 2^18 */
+#include <linux/types.h>
+#include <linux/atomic.h>
+
+#define SMAP_COLD_QUEUE_MAX_SIZE (262144 * 16) /* 2^22 */
 #define SMAP_COLD_QUEUE_MAX_MASK (SMAP_COLD_QUEUE_MAX_SIZE - 1)
 
 #ifndef SMAP_MAX_NUMNODES
@@ -19,9 +31,9 @@
 
 struct smap_cold_queue {
 	u64 *pfn;
-	unsigned int head; /* next dequeue index */
-	unsigned int tail; /* next enqueue index */
-	unsigned int count; /* current number of entries */
+	unsigned int head;	/* consumer only — no concurrency with drain */
+	atomic_t tail;		/* producers: fetch_add to claim a slot */
+	atomic_t count;		/* committed items: producers inc, consumer dec */
 };
 
 /*
@@ -33,6 +45,10 @@ extern struct smap_cold_queue smap_cold_numa_queue[SMAP_MAX_NUMNODES];
 void smap_cold_queue_free(void);
 int smap_cold_queue_init(void);
 
+/*
+ * Enqueue a PFN for swap-out. Returns 0 on success, -1 if queue is full.
+ * Must be called only during the scan phase (producers only).
+ */
 int smap_cold_queue_enqueue(int nid, u64 pfn);
 
 #endif /* _SRC_SMAP_COLD_QUEUE_H */
diff --git a/plugins/smap/src/tiering/mig_init.c b/plugins/smap/src/tiering/mig_init.c
index a0625a4..ae75982 100644
--- a/plugins/smap/src/tiering/mig_init.c
+++ b/plugins/smap/src/tiering/mig_init.c
@@ -275,12 +275,15 @@ static u64 smap_cold_queue_drain_entry(int nid, struct smap_cold_queue *q,
 				       u64 *batch)
 {
 	struct drain_stats stats = { 0 };
-	unsigned long flags;
 	u64 i;
 
-	spin_lock_irqsave(&smap_cold_pid_lock, flags);
-	stats.nr_total = q->count;
-	spin_unlock_irqrestore(&smap_cold_pid_lock, flags);
+	/*
+	 * Lock-free snapshot: during drain the consumer is the only thread
+	 * accessing this per-node queue (all producers have quiesced —
+	 * userspace guarantees drain ioctl arrives after scan is disabled).
+	 * head is touched only here; count is only decremented here.
+	 */
+	stats.nr_total = atomic_read(&q->count);
 	while (1) {
 		LIST_HEAD(folio_list);
 		struct folio *folio;
@@ -288,14 +291,19 @@ static u64 smap_cold_queue_drain_entry(int nid, struct smap_cold_queue *q,
 
 		cond_resched();
 
-		/* Dequeue PFNs from this node's queue */
-		spin_lock_irqsave(&smap_cold_pid_lock, flags);
-		while (q->count > 0 && dequeued < DRAIN_BATCH_SIZE) {
-			batch[dequeued++] = q->pfn[q->head];
-			q->head = (q->head + 1) & SMAP_COLD_QUEUE_PID_MAX_MASK;
-			q->count--;
+		/*
+		 * Dequeue up to DRAIN_BATCH_SIZE PFNs without a lock.
+		 * head is consumer-only; count is atomic because the
+		 * producer (scan) increments it, but during drain no
+		 * producers are active, so atomic_dec is safe.
+		 */
+		while (atomic_read(&q->count) > 0 &&
+		       dequeued < DRAIN_BATCH_SIZE) {
+			batch[dequeued++] = q->pfn[q->head &
+						  SMAP_COLD_QUEUE_MAX_MASK];
+			q->head++;
+			atomic_dec(&q->count);
 		}
-		spin_unlock_irqrestore(&smap_cold_pid_lock, flags);
 		if (dequeued == 0)
 			break;
 		stats.nr_dequeued += dequeued;

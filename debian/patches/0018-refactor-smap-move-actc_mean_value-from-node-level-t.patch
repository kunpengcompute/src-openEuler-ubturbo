From 6ababb93ba517a2e6916cd134b983bf38d8e2c8b Mon Sep 17 00:00:00 2001
From: lucas <1358497393@qq.com>
Date: Sat, 11 Jul 2026 14:40:38 +0800
Subject: [PATCH 18/43] refactor(smap): move actc_mean_value from node-level to
 per-PID level

---
 plugins/smap/src/drivers/access_pid.c      | 11 ++++++++
 plugins/smap/src/drivers/access_pid.h      |  4 +++
 plugins/smap/src/drivers/access_tracking.c |  6 -----
 plugins/smap/src/drivers/accessed_bit.c    | 31 ++--------------------
 plugins/smap/src/drivers/accessed_bit.h    |  2 --
 plugins/smap/src/drivers/hist_tracking.h   |  1 -
 6 files changed, 17 insertions(+), 38 deletions(-)

diff --git a/plugins/smap/src/drivers/access_pid.c b/plugins/smap/src/drivers/access_pid.c
index bf86b26..8ac2e1b 100644
--- a/plugins/smap/src/drivers/access_pid.c
+++ b/plugins/smap/src/drivers/access_pid.c
@@ -289,6 +289,9 @@ static void fill_actc_data_by_bitmap(struct access_pid *ap, int nid,
 		if (ap->decay_flag) {
 			adev->access_bit_actc_data[acidx] >>= 1;
 		}
+		/* Accumulate per-PID actc data for mean calculation (before decay) */
+		ap->actc_sum += adev->access_bit_actc_data[acidx];
+		ap->actc_count++;
 
 		/* 填充prior - 从mapping获取 */
 		if (ap->info.vm_size && ap->info.mapping &&
@@ -330,12 +333,20 @@ static void fill_pid_actc_data(struct access_pid *ap, struct actc_data *actc,
 	u32 mapping_offset = 0;
 	size_t actc_offset = 0;
 
+	/* Reset per-PID actc accumulators before traversal */
+	ap->actc_sum = 0;
+	ap->actc_count = 0;
+
 	for (nid = 0; nid < SMAP_MAX_NUMNODES; nid++) {
 		fill_actc_data_by_bitmap(ap, nid, actc + actc_offset,
 					 &actc_len[nid], mapping_offset);
 		mapping_offset += actc_len[nid];
 		actc_offset += ap->page_num[nid];
 	}
+
+	/* Compute per-PID actc mean value from all pages (hot + cold) */
+	if (ap->actc_count > 0)
+		ap->actc_mean_value = (actc_t)(ap->actc_sum / ap->actc_count);
 }
 
 static ssize_t mem_freq_read(struct file *file, char __user *buf, size_t cnt,
diff --git a/plugins/smap/src/drivers/access_pid.h b/plugins/smap/src/drivers/access_pid.h
index f56e946..d14b39e 100644
--- a/plugins/smap/src/drivers/access_pid.h
+++ b/plugins/smap/src/drivers/access_pid.h
@@ -83,6 +83,10 @@ struct access_pid {
 	u32 scan_done_count;
 	bool first_scan;
 	bool decay_flag;
+	/* Per-PID actc mean value (VM scan path only) */
+	actc_t actc_mean_value;
+	u64 actc_sum;
+	u64 actc_count;
 };
 
 typedef struct {
diff --git a/plugins/smap/src/drivers/access_tracking.c b/plugins/smap/src/drivers/access_tracking.c
index 6090cbd..3ce3b4f 100644
--- a/plugins/smap/src/drivers/access_tracking.c
+++ b/plugins/smap/src/drivers/access_tracking.c
@@ -483,7 +483,6 @@ static void work_func(struct work_struct *work)
 	int ret = 0;
 	int page_size;
 	struct access_tracking_dev *adev = get_first_access_dev();
-	struct access_tracking_dev *adev_iter;
 	struct access_pid *ap;
 	struct delayed_work *scan_work;
 	ktime_t start_time, end_time;
@@ -509,11 +508,6 @@ static void work_func(struct work_struct *work)
 	ap->first_scan = false;
 	up_read(&ap_data.lock);
 
-	/* Update cached mean value for all access tracking devices */
-	list_for_each_entry(adev_iter, &access_dev, list) {
-		adev_iter->actc_mean_value = calc_actc_mean_value(adev_iter);
-	}
-
 	adev_buffer_up_read();
 	end_time = ktime_get();
 	scan_time = ktime_to_us(ktime_sub(end_time, start_time));
diff --git a/plugins/smap/src/drivers/accessed_bit.c b/plugins/smap/src/drivers/accessed_bit.c
index ccb240c..b8393ac 100644
--- a/plugins/smap/src/drivers/accessed_bit.c
+++ b/plugins/smap/src/drivers/accessed_bit.c
@@ -369,33 +369,6 @@ static inline int get_numa_id_by_paddr(phys_addr_t paddr)
 	return page_to_nid(page);
 }
 
-/*
- * calc_actc_mean_value - Calculate the mean of non-zero actc_data entries.
- * @adev: access tracking device
- *
- * Traverses the access_bit_actc_data array and computes the average of
- * all non-zero entries. Returns 0 if all entries are zero (e.g. during
- * the first scan cycle).
- */
-actc_t calc_actc_mean_value(struct access_tracking_dev *adev)
-{
-	u64 sum = 0;
-	u64 count = 0;
-	u64 i;
-
-	if (!adev->access_bit_actc_data || adev->page_count == 0)
-		return 0;
-
-	for (i = 0; i < adev->page_count; i++) {
-		if (adev->access_bit_actc_data[i] > 0) {
-			sum += adev->access_bit_actc_data[i];
-			count++;
-		}
-	}
-
-	return count > 0 ? (actc_t)(sum / count) : 0;
-}
-
 /*
  * Common lookup: resolve paddr → &actc_data[pa_index].
  * Returns NULL for non-local, non-tracked, or histogram pages.
@@ -429,8 +402,8 @@ static void actc_data_lookup_entry(phys_addr_t paddr, u32 page_size, struct acce
 		return;
 	if (smap_page_init(page)) {
 		smap_page_mark(page);
-		/* New pages are considered relatively hot: use cached mean value */
-		adev->access_bit_actc_data[pa_index] = adev->actc_mean_value;
+		/* New pages: use per-PID cached mean value */
+		adev->access_bit_actc_data[pa_index] = ap->actc_mean_value;
 	} else {
 		adev->access_bit_actc_data[pa_index]++;
 		if (adev->access_bit_actc_data[pa_index] >= ACTC_MAX) {
diff --git a/plugins/smap/src/drivers/accessed_bit.h b/plugins/smap/src/drivers/accessed_bit.h
index 6933fa6..6c0fc56 100644
--- a/plugins/smap/src/drivers/accessed_bit.h
+++ b/plugins/smap/src/drivers/accessed_bit.h
@@ -13,7 +13,6 @@
 #include "check.h"
 #include "kvm_pgtable.h"
 
-struct access_tracking_dev;
 #define SCAN_PERIOD_UNIT_MS 50
 
 #define MMAPLOCK_BATCH_SIZE (64UL * 1024 * 1024)
@@ -96,5 +95,4 @@ int scan_hva_info(pid_t pid_nr, u64 *l1_page_num, u64 *l2_page_num,
 		  u64 **l1_vaddr, u64 **l2_vaddr);
 int scan_hva_info_4k(pid_t pid, u64 *l1_page_num, u64 *l2_page_num,
 		     u64 **l1_vaddr, u64 **l2_vaddr);
-actc_t calc_actc_mean_value(struct access_tracking_dev *adev);
 #endif /* _SRC_ACCESSED_BIT_H */
diff --git a/plugins/smap/src/drivers/hist_tracking.h b/plugins/smap/src/drivers/hist_tracking.h
index 351ad75..cd1f2a2 100644
--- a/plugins/smap/src/drivers/hist_tracking.h
+++ b/plugins/smap/src/drivers/hist_tracking.h
@@ -30,7 +30,6 @@ struct access_tracking_dev {
 	void *tracking_dev;
 	actc_t *access_bit_actc_data;
 	u64 page_count;
-	actc_t actc_mean_value;	/* cached mean of non-zero actc_data entries */
 	u8 page_size_mode;
 	bool enable_on;
 	bool is_hist;

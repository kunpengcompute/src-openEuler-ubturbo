+	unsigned int scan_round; /* monotonic scan round counter */
+	unsigned int force_scan_interval; /* full scan every N rounds */
+	bool force_scan; /* true = skip bloom filter, scan all PMDs */
+	u64 total_pmds; /* PMDs visited this round */
+	u64 skipped_pmds; /* PMDs actually walked this round */

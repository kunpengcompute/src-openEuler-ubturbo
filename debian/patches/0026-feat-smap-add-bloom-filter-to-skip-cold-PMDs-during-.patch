 	scan_work = to_delay_work(work);
 	ap = delay_work_to_ap(scan_work);
 
+	/* Bloom filter: round-level decisions at start, per-scan counters */
+	if (ap->type == NORMAL_SCAN && enable_bloom_filter) {
+		if (ap->cur_times == 0) {
+			ap->force_scan =
+				(ap->scan_round % force_scan_interval == 0);
+			if (ap->force_scan)
+				reset_bloom_filter(ap);
+			ap->scan_round++;
+		}
+		ap->total_pmds = 0;
+		ap->skipped_pmds = 0;

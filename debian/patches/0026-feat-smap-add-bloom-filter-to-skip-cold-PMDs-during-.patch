+/*
+ * Bloom filter helpers — marks PMDs that had hot pages so the next scan
+ * round can skip cold PMDs. Uses hash_64() with PMD-shifted address for
+ * uniform distribution across the 4096-bit filter.
+ */
+static unsigned long bloom_filter_hash(unsigned long pmd_addr)
+{
+	return hash_64(pmd_addr >> PMD_SHIFT, SMAP_BLOOM_FILTER_SHIFT);
+}
+
+static bool test_bloom_filter(struct access_pid *ap, unsigned long pmd_addr)
+{
+	if (!ap || !ap->bloom_filter)
+		return false;
+	return test_bit(bloom_filter_hash(pmd_addr), ap->bloom_filter);
+}
+
+static void update_bloom_filter(struct access_pid *ap, unsigned long pmd_addr)
+{
+	if (!ap || !ap->bloom_filter)
+		return;
+	set_bit(bloom_filter_hash(pmd_addr), ap->bloom_filter);
+}
+
+void reset_bloom_filter(struct access_pid *ap)
+{
+	if (!ap || !ap->bloom_filter)
+		return;
+	bitmap_zero(ap->bloom_filter, SMAP_BLOOM_FILTER_BITS);
+}
+
+static int smap_pmd_entry(pmd_t *pmd, unsigned long addr, unsigned long next,
+			  struct mm_walk *walk)
+{
+	struct pte_walk *pte_walk = walk->private;
+	struct access_pid *ap = pte_walk->ap;
+
+	ap->total_pmds++;
+
+	/* No bloom filter → scan everything (non-NORMAL_SCAN or not yet allocated) */
+	if (!ap->bloom_filter || pte_walk->force_scan)
+		return 0;
+
+	if (test_bloom_filter(ap, addr))
+		return 0;
+
+	/* Skip this PMD's PTEs, continue to next PMD */
+	ap->skipped_pmds++;
+	walk->action = ACTION_CONTINUE;
+	return 0;
+}
+
 static int check_pte_young(pte_t *pte, unsigned long addr, unsigned long next,
 			   struct mm_walk *walk)
 {
@@ -1715,6 +1795,8 @@ static int check_pte_young(pte_t *pte, unsigned long addr, unsigned long next,
 #endif
 		}
 		pte_walk->flag = true;
+		/* Mark this PMD for re-scan next round */
+		update_bloom_filter(pte_walk->ap, addr & PMD_MASK);
 	}
 

@@ -983,6 +991,27 @@ static int process_memslot_pages(struct kvm *kvm,
 		ktime_t start_time, end_time;
 		s64 walk_time, update_time;
 
+		hva = gfn_to_hva_memslot(memslot, gpa_to_gfn(gpa));
+
+		/* PMD-level counting for 4K NORMAL_SCAN */
+		if (use_bloom) {

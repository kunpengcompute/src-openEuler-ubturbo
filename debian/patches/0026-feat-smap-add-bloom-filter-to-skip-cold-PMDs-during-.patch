+/* Bloom filter: marks PMDs that had hot pages last round */
+#define SMAP_BLOOM_FILTER_SHIFT 15 /* 32768 bits = 4 KiB */
+#define SMAP_BLOOM_FILTER_BITS (1UL << SMAP_BLOOM_FILTER_SHIFT)
+#define SMAP_BLOOM_FILTER_SIZE (SMAP_BLOOM_FILTER_BITS / BITS_PER_BYTE)

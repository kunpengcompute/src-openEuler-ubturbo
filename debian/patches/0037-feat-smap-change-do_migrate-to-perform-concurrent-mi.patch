+static int migrate_item_worker(void *data)
+{
+	struct mig_item_work *w = data;
+	unsigned int i, k;
+
+	/* Sort this worker's items by source node descending, so higher-from
+	 * (promotion) entries migrate before lower-from (demotion) ones within
+	 * the group -- mirroring the old serial "max_from" selection order. */
+	for (i = 0; i + 1 < w->nr_items; i++) {
+		unsigned int max = i;
+
+		for (k = i + 1; k < w->nr_items; k++) {
+			if (w->items[k]->from > w->items[max]->from)
+				max = k;
+		}
+		if (max != i) {
+			struct mig_list *tmp = w->items[i];
+
+			w->items[i] = w->items[max];
+			w->items[max] = tmp;
+		}
 	}
-	kfree(arr);
-	pr_debug("non anon page number: %u\n", non_anon_num);
-	pr_debug("swap cache numa: %u\n", swap_cache_num);
-	return failed_num;
+
+	/* single->is_mul_thread is false: item-internal migrate runs
+	 * single-threaded so concurrent items don't race the global mig[]. */
+	for (i = 0; i < w->nr_items; i++) {
+		unsigned int failed;
+
+		failed = do_migrate_one_item(w->items[i], w->msg, w->single,
+					     w->abnormal);
+		w->total_failed += failed;
+	}
+	complete(&w->comp);
+	return 0;
+}
+
+int do_migrate(struct migrate_msg *msg, struct mig_list *mig_list)
+{
+	int i, j;
+	unsigned int total_failed = 0;
+	unsigned int nr_workers;
+	unsigned int base, extra, cur;
+	struct mig_item_work *works;
+	struct mig_pra single;
+
+	memset(nr_abnormal, 0, sizeof(nr_abnormal));
+	if (msg->cnt == 0)
+		return 0;
+
+	/* Item-internal migrate is forced single-threaded: the per-worker kthreads
+	 * below already provide parallelism across mig_list entries, and touching
+	 * the global mig[] from concurrent items would corrupt it. */
+	single = msg->mul_mig;
+	single.is_mul_thread = false;
+	single.nr_thread = 1;
+
+	/* Split the msg->cnt items into nr_workers contiguous groups; each worker
+	 * serially migrates its own group. Extra items are spread one-per-worker so
+	 * the first (msg->cnt % nr_workers) workers get one extra item. */
+	nr_workers = min((unsigned int)msg->cnt,
+			 (unsigned int)MIG_ITEM_MAX_WORKERS);
+	works = kcalloc(nr_workers, sizeof(*works), GFP_KERNEL);
+	if (!works)
+		return -ENOMEM;
+
+	base = msg->cnt / nr_workers;
+	extra = msg->cnt % nr_workers;
+	cur = 0;
+	for (i = 0; i < nr_workers; i++) {
+		unsigned int group = base + (i < extra ? 1 : 0);
+		unsigned int k;
+
+		init_completion(&works[i].comp);
+		/* Independent pointer array so the worker can reorder it (by from,
+		 * descending) without disturbing the caller's mig_list indexing. */
+		works[i].items =
+			kmalloc_array(group, sizeof(*works[i].items), GFP_KERNEL);
+		if (!works[i].items) {
+			works[i].nr_items = 0;
+			pr_err("failed to allocate item array for worker %d\n", i);
+			cur += group;
+			continue;
+		}
+		for (k = 0; k < group; k++)
+			works[i].items[k] = &mig_list[cur + k];
+		works[i].nr_items = group;
+		works[i].msg = msg;
+		works[i].single = &single;
+		works[i].total_failed = 0;
+		memset(works[i].abnormal, 0, sizeof(works[i].abnormal));
+		works[i].ts = NULL;
+		cur += group;
+	}
+
+	/* Launch all workers concurrently. */
+	for (i = 0; i < nr_workers; i++) {
+		if (works[i].nr_items == 0)
+			continue;
+		works[i].ts = kthread_run(migrate_item_worker, &works[i],
+					  "smap_mig_item");
+		if (IS_ERR(works[i].ts)) {
+			works[i].ts = NULL;
+			pr_err("failed to start migrate worker %d\n", i);
+			/* Drain this group inline on the caller thread as a fallback. */
+			for (j = 0; j < (int)works[i].nr_items; j++) {
+				works[i].total_failed += do_migrate_one_item(
+					works[i].items[j], msg, &single,
+					works[i].abnormal);
+			}
+		}
+	}
+
+	/* Wait for every worker, merge per-worker stats into the globals. */
+	for (i = 0; i < nr_workers; i++) {
+		if (works[i].nr_items == 0 || !works[i].ts)
+			continue;
+		wait_for_completion(&works[i].comp);
+		total_failed += works[i].total_failed;
+		for (j = 0; j < NR_ABNORMAL; j++)
+			nr_abnormal[j] += works[i].abnormal[j];
+	}
+
+	for (i = 0; i < nr_workers; i++)
+		kfree(works[i].items);
+	kfree(works);
+	return total_failed;
 }
 

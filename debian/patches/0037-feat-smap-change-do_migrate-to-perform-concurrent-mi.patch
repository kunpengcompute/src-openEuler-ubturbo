+/* Item-level (mig_list entry) parallelism in do_migrate: several mig_list
+ * entries are migrated concurrently by independent kthreads, each running
+ * the single-threaded migrate path so the global mig[] array is untouched. */
+#define MIG_ITEM_MAX_WORKERS 4
+
+struct mig_item_work {
+	struct mig_list **items; /* items assigned to this worker */
+	unsigned int nr_items;    /* count of items in the group */
+	struct migrate_msg *msg;
+	struct mig_pra *single; /* mul_mig with is_mul_thread=false */
+	unsigned int total_failed; /* sum of failed_mig_nr across the group */
+	size_t abnormal[NR_ABNORMAL]; /* per-worker, merged by caller */
+	struct completion comp;
+	struct task_struct *ts;
+};

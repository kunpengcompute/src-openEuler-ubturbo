 /*
- * Bloom filter helpers — marks PMDs that had hot pages so the next scan
- * round can skip cold PMDs. Uses hash_64() with PMD-shifted address for
- * uniform distribution across the 4096-bit filter.
+ * Bloom filter helpers — double-buffered, k=2 hash.
+ * Borrow MGLRU's pattern: query current-generation filter, write to next.
  */
-static unsigned long bloom_filter_hash(unsigned long pmd_addr)
+static void get_item_key(unsigned long pmd_addr, int key[2])
 {
-	return hash_64(pmd_addr >> PMD_SHIFT, SMAP_BLOOM_FILTER_SHIFT);
+	u32 hash = hash_64(pmd_addr >> PMD_SHIFT, SMAP_BLOOM_FILTER_SHIFT * 2);
+
+	BUILD_BUG_ON(SMAP_BLOOM_FILTER_SHIFT * 2 > BITS_PER_TYPE(u32));
+
+	key[0] = hash & (BIT(SMAP_BLOOM_FILTER_SHIFT) - 1);
+	key[1] = hash >> SMAP_BLOOM_FILTER_SHIFT;
 }
 
-static bool test_bloom_filter(struct access_pid *ap, unsigned long pmd_addr)
+static bool test_bloom_filter(struct access_pid *ap, unsigned long seq,
+			      unsigned long pmd_addr)
 {
-	if (!ap || !ap->bloom_filter)
+	int key[2];
+	unsigned long *filter;
+	int gen = filter_gen_from_seq(seq);
+
+	filter = ap->bloom_filters[gen];
+	if (!filter)
 		return false;
-	return test_bit(bloom_filter_hash(pmd_addr), ap->bloom_filter);
+
+	get_item_key(pmd_addr, key);
+	return test_bit(key[0], filter) && test_bit(key[1], filter);
 }
 
-static void update_bloom_filter(struct access_pid *ap, unsigned long pmd_addr)
+static void update_bloom_filter(struct access_pid *ap, unsigned long seq,
+				unsigned long pmd_addr)
 {
-	if (!ap || !ap->bloom_filter)
+	int key[2];
+	unsigned long *filter;
+	int gen = filter_gen_from_seq(seq);
+
+	filter = ap->bloom_filters[gen];
+	if (!filter)
 		return;
-	set_bit(bloom_filter_hash(pmd_addr), ap->bloom_filter);
+
+	get_item_key(pmd_addr, key);
+	if (!test_bit(key[0], filter))
+		set_bit(key[0], filter);
+	if (!test_bit(key[1], filter))
+		set_bit(key[1], filter);
 }
 
-void reset_bloom_filter(struct access_pid *ap)
+/*
+ * suitable_to_scan — MGLRU's threshold: a PMD is hot if the average number
+ * of young PTEs per cacheline is >= 1. n scales with cache_line_size().
+ */
+static bool suitable_to_scan(int total, int young)
 {
-	if (!ap || !ap->bloom_filter)
-		return;
-	bitmap_zero(ap->bloom_filter, SMAP_BLOOM_FILTER_BITS);
+	int n = clamp_t(int, cache_line_size() / sizeof(pte_t), 2, 8);
+	pr_debug("suitable_to_scan: total=%d young=%d\n", total, young);
+	return young * n >= total;
 }
 
 static int smap_pmd_entry(pmd_t *pmd, unsigned long addr, unsigned long next,
@@ -1723,17 +1779,40 @@ static int smap_pmd_entry(pmd_t *pmd, unsigned long addr, unsigned long next,
 {
 	struct pte_walk *pte_walk = walk->private;
 	struct access_pid *ap = pte_walk->ap;
+	unsigned long current_pmd_addr = addr & PMD_MASK;
+	pmd_t val = pmdp_get_lockless(pmd);
+
+	/* Flush previous PMD's suitable_to_scan result into bloom filter */
+	if (pte_walk->current_pmd_valid &&
+	    pte_walk->current_pmd != current_pmd_addr &&
+	    ap->bloom_filters[0] && pte_walk->pmd_total > 0) {
+		if (suitable_to_scan(pte_walk->pmd_total, pte_walk->pmd_young))
+			update_bloom_filter(ap, ap->scan_seq,
+					    pte_walk->current_pmd);
+		pte_walk->pmd_total = 0;
+		pte_walk->pmd_young = 0;
+	}
+	pte_walk->current_pmd = current_pmd_addr;
+	pte_walk->current_pmd_valid = true;
 
 	ap->total_pmds++;
 
-	/* No bloom filter → scan everything (non-NORMAL_SCAN or not yet allocated) */
-	if (!ap->bloom_filter || pte_walk->force_scan)
+	if (!pmd_present(val) || pmd_trans_huge(val) || pmd_devmap(val))
+		return 0;
+
+	/* Layer 1: PMD young bit fast-path — skip PMDs not accessed */
+	if (!pte_walk->force_scan && !pmd_young(val) &&
+	    !access_pid_cur_last_scanning(ap))
+		goto skip_pmd;
+
+	/* Layer 2: Bloom filter — skip PMDs not marked hot last round */
+	if (!ap->bloom_filters[0] || pte_walk->force_scan)
 		return 0;
 
-	if (test_bloom_filter(ap, addr))
+	if (test_bloom_filter(ap, ap->scan_seq - 1, current_pmd_addr))
 		return 0;
 
-	/* Skip this PMD's PTEs, continue to next PMD */
+skip_pmd:
 	ap->skipped_pmds++;
 	walk->action = ACTION_CONTINUE;
 	return 0;
@@ -1766,9 +1845,13 @@ static int check_pte_young(pte_t *pte, unsigned long addr, unsigned long next,
 	is_local = nid < nr_local_numa;
 	if (!is_local && enable_hist && pte_walk->type == NORMAL_SCAN) {
 		is_young = false;
-		goto save_res;
 	}
 
+	/* Accumulate per-PMD counters for suitable_to_scan */
+	pte_walk->pmd_total++;
+	if (is_young)
+		pte_walk->pmd_young++;
+
 	/* 64KiB分组优化：NORMAL_SCAN类型，首页young则跳过后续页 */
 	if (pte_walk->type == NORMAL_SCAN) {
 		bool is_first = (addr & (SCAN_GROUP_SIZE - 1)) == 0;
@@ -1795,8 +1878,6 @@ static int check_pte_young(pte_t *pte, unsigned long addr, unsigned long next,
 #endif
 		}
 		pte_walk->flag = true;
-		/* Mark this PMD for re-scan next round */
-		update_bloom_filter(pte_walk->ap, addr & PMD_MASK);
 	}
 
 save_res:
@@ -1867,6 +1948,23 @@ static void process_scan_results(struct pte_walk *pte_walk)
 	}
 }
 
+static void flush_last_pmd_bloom(struct pte_walk *pte_walk)
+{
+	struct access_pid *ap = pte_walk->ap;
+
+	if (!ap || !ap->bloom_filters[0])
+		return;
+	if (!pte_walk->current_pmd_valid)
+		return;
+	if (pte_walk->pmd_total > 0 &&
+	    suitable_to_scan(pte_walk->pmd_total, pte_walk->pmd_young))
+		update_bloom_filter(ap, ap->scan_seq, pte_walk->current_pmd);
+	pte_walk->pmd_total = 0;
+	pte_walk->pmd_young = 0;
+	pte_walk->current_pmd = 0;
+	pte_walk->current_pmd_valid = false;
+}
+
 static int small_vma_walk(struct mm_struct *mm, unsigned long start_vaddr,
 			  unsigned long end_vaddr, struct pte_walk *pte_walk,
 			  const struct mm_walk_ops *ops)
@@ -1882,6 +1980,7 @@ static int small_vma_walk(struct mm_struct *mm, unsigned long start_vaddr,
 
 	ret = walk_page_range(mm, start_vaddr, end_vaddr, ops, pte_walk);
 	mmap_read_unlock(mm);
+	flush_last_pmd_bloom(pte_walk);
 	cond_resched();
 	process_scan_results(pte_walk);
 	return ret;

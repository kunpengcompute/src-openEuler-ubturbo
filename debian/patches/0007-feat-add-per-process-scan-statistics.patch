From c2869af6bed8c7abe68b298aa7e58da3458d0546 Mon Sep 17 00:00:00 2001
From: Pang Jiming <discrete_brain@163.com>
Date: Wed, 17 Jun 2026 21:02:51 +0800
Subject: [PATCH 07/43] feat: add per-process scan statistics

Accumulate scan time and scanned pages across all scan rounds in
work_func(), and expose the aggregate via /proc/smap/<pid>/scan_stat.

Userspace reads the stats after DisableTracking() in ScanMigrateWork()
to analyze scan overhead vs memory size relationship per process.

New fields in struct access_pid:
- total_scan_time_us: cumulative scan time (microseconds)
- total_scanned_pages: cumulative pages scanned
- scan_done_count: number of completed scan rounds
---
 plugins/smap/src/drivers/access_pid.c      | 71 +++++++++++++++++++---
 plugins/smap/src/drivers/access_pid.h      | 14 +++++
 plugins/smap/src/drivers/access_tracking.c | 12 ++++
 plugins/smap/src/user/strategy/migration.c | 24 ++++++++
 4 files changed, 111 insertions(+), 10 deletions(-)

diff --git a/plugins/smap/src/drivers/access_pid.c b/plugins/smap/src/drivers/access_pid.c
index 52a60b1..c015ea8 100644
--- a/plugins/smap/src/drivers/access_pid.c
+++ b/plugins/smap/src/drivers/access_pid.c
@@ -335,16 +335,6 @@ static void fill_pid_actc_data(struct access_pid *ap, struct actc_data *actc,
 	}
 }
 
-static inline size_t calc_process_page_number(struct access_pid *ap)
-{
-	int i;
-	size_t ret_len = 0;
-	for (i = 0; i < SMAP_MAX_NUMNODES; i++) {
-		ret_len += ap->page_num[i];
-	}
-	return ret_len;
-}
-
 static ssize_t mem_freq_read(struct file *file, char __user *buf, size_t cnt,
 			     loff_t *ppos)
 {
@@ -412,6 +402,54 @@ static const struct proc_ops ap_mem_freq_fops = {
 	.proc_read = mem_freq_read,
 };
 
+static ssize_t scan_stat_read(struct file *file, char __user *buf, size_t cnt,
+			      loff_t *ppos)
+{
+	struct access_pid *ap = file->private_data;
+	char kbuf[256];
+	ssize_t len;
+	s64 avg_time_us = 0;
+	size_t avg_pages = 0;
+
+	if (*ppos > 0)
+		return 0;
+
+	if (ap->scan_done_count > 0) {
+		avg_time_us = ap->total_scan_time_us / ap->scan_done_count;
+		avg_pages = ap->total_scanned_pages / ap->scan_done_count;
+	}
+
+	len = snprintf(kbuf, sizeof(kbuf),
+		       "count=%u total_time_us=%lld total_pages=%zu "
+		       "avg_time_us=%lld avg_pages=%zu\n",
+		       ap->scan_done_count,
+		       ap->total_scan_time_us,
+		       ap->total_scanned_pages,
+		       avg_time_us, avg_pages);
+	if (len < 0)
+		return -EFAULT;
+
+	if (cnt < len)
+		return -EINVAL;
+
+	if (copy_to_user(buf, kbuf, len))
+		return -EFAULT;
+
+	*ppos += len;
+	return len;
+}
+
+static int scan_stat_open(struct inode *inode, struct file *file)
+{
+	file->private_data = pde_data(inode);
+	return 0;
+}
+
+static const struct proc_ops ap_scan_stat_fops = {
+	.proc_open = scan_stat_open,
+	.proc_read = scan_stat_read,
+};
+
 static int create_procfs_freq(struct access_pid *ap)
 {
 	struct proc_dir_entry *freq_pde;
@@ -449,6 +487,7 @@ static int create_procfs(struct access_pid *ap)
 	int ret;
 	char dirname[AP_PROCFS_DIR_LEN] = { 0 };
 	struct proc_dir_entry *root_pde;
+	struct proc_dir_entry *stat_pde;
 	pid_t pid = ap->pid;
 
 	if (!smap_procfs_root)
@@ -480,6 +519,18 @@ static int create_procfs(struct access_pid *ap)
 		ap->proc_root = NULL;
 		return ret;
 	}
+
+	/* create /proc/smap/<pid>/scan_stat */
+	stat_pde = proc_create_data("scan_stat", S_IRUSR | S_IRGRP,
+				    ap->proc_root, &ap_scan_stat_fops, ap);
+	if (!stat_pde) {
+		pr_err("failed to create proc scan_stat for %d\n", ap->pid);
+		proc_remove(ap->proc_root);
+		ap->proc_root = NULL;
+		return -ENOMEM;
+	}
+	proc_set_user(stat_pde, procfs_kuid, procfs_kgid);
+
 	return 0;
 }
 
diff --git a/plugins/smap/src/drivers/access_pid.h b/plugins/smap/src/drivers/access_pid.h
index a91a323..49cd47e 100644
--- a/plugins/smap/src/drivers/access_pid.h
+++ b/plugins/smap/src/drivers/access_pid.h
@@ -76,6 +76,10 @@ struct access_pid {
 	unsigned long last_scan_delay_ms;
 	struct proc_dir_entry *proc_root;
 	struct proc_dir_entry *proc_freq;
+	/* scan statistics: accumulated across all scan rounds */
+	s64 total_scan_time_us;
+	size_t total_scanned_pages;
+	u32 scan_done_count;
 	bool first_scan;
 };
 
@@ -129,6 +133,16 @@ int init_ap_bm_white_list(int node_len, u64 *node_page_count,
 int init_vm_mapping(struct vm_mapping_info *info);
 int access_walk_pagemap_prepare(struct access_pid *ap);
 
+static inline size_t calc_process_page_number(struct access_pid *ap)
+{
+	int i;
+	size_t ret_len = 0;
+	for (i = 0; i < SMAP_MAX_NUMNODES; i++) {
+		ret_len += ap->page_num[i];
+	}
+	return ret_len;
+}
+
 static inline bool access_pid_is_scanning(pid_t pid)
 {
 	struct access_pid *ap = find_access_pid(pid);
diff --git a/plugins/smap/src/drivers/access_tracking.c b/plugins/smap/src/drivers/access_tracking.c
index 052a4fd..049995d 100644
--- a/plugins/smap/src/drivers/access_tracking.c
+++ b/plugins/smap/src/drivers/access_tracking.c
@@ -104,6 +104,9 @@ static void submit_scan_works(struct access_tracking_dev *adev)
 	down_read(&ap_data.lock);
 	list_for_each_entry(ap, &ap_data.list, node) {
 		ap->cur_times = 0;
+		ap->total_scan_time_us = 0;
+		ap->total_scanned_pages = 0;
+		ap->scan_done_count = 0;
 		submit_one_work(ap);
 	}
 	up_read(&ap_data.lock);
@@ -486,6 +489,15 @@ static void work_func(struct work_struct *work)
 	pr_debug("pid[%d] cpu[%d], scan took %lldus for %dth time\n", ap->pid,
 		 raw_smp_processor_id(), scan_time, ap->cur_times);
 
+	/* accumulate scan statistics */
+	ap->total_scan_time_us += scan_time;
+	ap->scan_done_count++;
+	if (page_size == g_pagesize_huge) {
+		ap->total_scanned_pages += ap->info.vm_size;
+	} else {
+		ap->total_scanned_pages += calc_process_page_number(ap);
+	}
+
 	scan_delay_ms = ap->scan_time;
 	if (ap->type == STATISTIC_SCAN) {
 		handle_statistic_scan(ap, start_time, scan_time,
diff --git a/plugins/smap/src/user/strategy/migration.c b/plugins/smap/src/user/strategy/migration.c
index 4d38d99..ebd3f51 100644
--- a/plugins/smap/src/user/strategy/migration.c
+++ b/plugins/smap/src/user/strategy/migration.c
@@ -678,6 +678,29 @@ static void UpdatePeriodFromConfig(ThreadCtx *ctx)
     }
 }
 
+static void ReadScanStats(struct ProcessManager *manager)
+{
+    ProcessAttr *attr;
+    char path[64];
+    char buf[256];
+    int fd;
+    ssize_t n;
+
+    for (attr = manager->processes; attr; attr = attr->next) {
+        snprintf(path, sizeof(path), "/proc/smap/%d/scan_stat", attr->pid);
+        fd = open(path, O_RDONLY);
+        if (fd < 0) {
+            continue;
+        }
+        n = read(fd, buf, sizeof(buf) - 1);
+        close(fd);
+        if (n > 0) {
+            buf[n] = '\0';
+            SMAP_LOGGER_INFO("pid %d scan_stat: %s", attr->pid, buf);
+        }
+    }
+}
+
 // 管理线程函数
 int ScanMigrateWork(ThreadCtx *ctx)
 {
@@ -691,6 +714,7 @@ int ScanMigrateWork(ThreadCtx *ctx)
         goto out;
     }
     SMAP_LOGGER_DEBUG("Tracking disabled.");
+    ReadScanStats(manager);
     // 由于进程销毁是异步，后续涉及ProcessAttr需要合理处理异常
     CheckAndRemoveInvalidProcess();
     ret = PerformMigrationPreparation(manager);

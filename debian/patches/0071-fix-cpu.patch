 protected:
@@ -36,6 +37,18 @@ protected:
     }
 };
 
+extern "C" bool is_smap_pg_huge(void);
+TEST_F(TrackingManageTest, IsSmapPgHuge)
+{
+    smap_pgsize = HUGE_PAGE;
+    bool ret = is_smap_pg_huge();
+    EXPECT_EQ(true, ret);
+
+    smap_pgsize = 0;
+    ret = is_smap_pg_huge();
+    EXPECT_EQ(false, ret);
+}

From 0207f2cdb0edc2166f90c26363b26e560a3bd5c1 Mon Sep 17 00:00:00 2001
From: Jiming Pang <discrete_brain@163.com>
Date: Wed, 29 Jul 2026 20:39:10 +0800
Subject: [PATCH 08/43] add folio_free_swap

---
 plugins/smap/src/tiering/smap_migrate_pages.c   | 7 +++++++
 plugins/smap/src/tiering/smap_migrate_wrapper.c | 5 ++++-
 plugins/smap/src/tiering/smap_migrate_wrapper.h | 1 +
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/plugins/smap/src/tiering/smap_migrate_pages.c b/plugins/smap/src/tiering/smap_migrate_pages.c
index f544d29..dbcfb0c 100644
--- a/plugins/smap/src/tiering/smap_migrate_pages.c
+++ b/plugins/smap/src/tiering/smap_migrate_pages.c
@@ -792,6 +792,7 @@ int do_migrate(struct migrate_msg *msg, struct mig_list *mig_list)
 	unsigned int pre_migrate_failed;
 	unsigned int failed_num = 0;
 	unsigned int non_anon_num = 0;
+	unsigned int swap_cache_num = 0;
 	unsigned int tmp_pre_migrate_nr;
 	unsigned long pfn;
 	int pre_migrate_flag = -1;
@@ -890,6 +891,11 @@ again:
 				nr_abnormal[err]++;
 				continue;
 			}
+			if (PageSwapCache(p_page)) {
+				if (!fp_folio_free_swap(page_folio(p_page))) {
+					swap_cache_num++;
+				}
+			}
 			pre_migrate_flag = smap_add_page_for_migration(
 				p_page, migrate_folios, &nr_folios,
 				mig_list[i].pid, MPOL_MF_MOVE_ALL);
@@ -935,6 +941,7 @@ again:
 	}
 	kfree(arr);
 	pr_debug("non anon page number: %u\n", non_anon_num);
+	pr_debug("swap cache numa: %u\n", swap_cache_num);
 	return failed_num;
 }
 
diff --git a/plugins/smap/src/tiering/smap_migrate_wrapper.c b/plugins/smap/src/tiering/smap_migrate_wrapper.c
index 1618101..f369f74 100644
--- a/plugins/smap/src/tiering/smap_migrate_wrapper.c
+++ b/plugins/smap/src/tiering/smap_migrate_wrapper.c
@@ -25,6 +25,7 @@ unsigned long (*fp_reclaim_pages)(struct list_head *folio_list,
 bool (*fp_isolate_hugetlb)(struct folio *folio, struct list_head *list) = NULL;
 void (*fp_folio_putback_lru)(struct folio *folio) = NULL;
 bool (*fp_folio_isolate_lru)(struct folio *folio) = NULL;
+bool (*fp_folio_free_swap)(struct folio *folio) = NULL;
 
 static inline unsigned long *get_pageblock_bitmap(const struct page *p,
 						  unsigned long pfn)
@@ -81,8 +82,10 @@ int smap_process_symbols(void)
 		struct folio *))fp_kallsyms_lookup_name("folio_putback_lru");
 	fp_folio_isolate_lru = (bool (*)(
 		struct folio *))fp_kallsyms_lookup_name("folio_isolate_lru");
+	fp_folio_free_swap = (bool (*)(
+		struct folio *))fp_kallsyms_lookup_name("folio_free_swap");
 	if (!fp_reclaim_pages || !fp_isolate_hugetlb || !fp_folio_putback_lru ||
-	    !fp_folio_isolate_lru)
+	    !fp_folio_isolate_lru || !fp_folio_free_swap)
 		pr_warn("smap: swap-out symbols missing (reclaim_pages=%p "
 			"isolate_hugetlb=%p folio_putback_lru=%p "
 			"folio_isolate_lru=%p)\n",
diff --git a/plugins/smap/src/tiering/smap_migrate_wrapper.h b/plugins/smap/src/tiering/smap_migrate_wrapper.h
index b8c9fab..610fca7 100644
--- a/plugins/smap/src/tiering/smap_migrate_wrapper.h
+++ b/plugins/smap/src/tiering/smap_migrate_wrapper.h
@@ -136,6 +136,7 @@ extern unsigned long (*fp_reclaim_pages)(struct list_head *folio_list,
 extern bool (*fp_isolate_hugetlb)(struct folio *folio, struct list_head *list);
 extern void (*fp_folio_putback_lru)(struct folio *folio);
 extern bool (*fp_folio_isolate_lru)(struct folio *folio);
+extern bool (*fp_folio_free_swap)(struct folio *folio);
 
 int smap_process_symbols(void);
 struct folio *smap_alloc_huge_page_node(struct folio *folio, int nid,
-- 
2.54.0.windows.1


+        g_tmpStrategyConfig.groupSwapLocalWatermarkRatio > MAX_GROUP_SWAP_LOCAL_WATERMARK_RATIO) {
+        SMAP_LOGGER_ERROR("Config group swap local watermark ratio(%u) invalid, range(%d-%d), key:%s.",

From b30e3f244b9cd2fc3a79c8fae0f305dc524f264e Mon Sep 17 00:00:00 2001
From: Jiming Pang <discrete_brain@163.com>
Date: Fri, 3 Jul 2026 15:00:41 +0800
Subject: [PATCH 27/43] refactor(smap): extract log_bloom_stats, accumulate
 counters per round

Extract bloom filter stats printing to log_bloom_stats() and add skip_rate
to the output. Move counter reset into cur_times==0 block so total_pmds
and skipped_pmds accumulate across all scans in a round, fixing the bug
where skipped_pmds was always 0 in the log (last scan doesn't skip due to
access_pid_cur_last_scanning guard).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 plugins/smap/src/drivers/access_tracking.c | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/plugins/smap/src/drivers/access_tracking.c b/plugins/smap/src/drivers/access_tracking.c
index 5e335d5..cf9a0a2 100644
--- a/plugins/smap/src/drivers/access_tracking.c
+++ b/plugins/smap/src/drivers/access_tracking.c
@@ -491,6 +491,14 @@ static void handle_statistic_scan(struct access_pid *ap, ktime_t start_time,
 		ap->pid, delay_buffer_ms, *scan_delay_ms);
 }
 
+static void log_bloom_stats(struct access_pid *ap)
+{
+	pr_info("[bloom_filter] pid=%d total_pmd=%llu skipped_pmd=%llu skip_rate=%llu%% scan_round=%u force=%s\n",
+		ap->pid, ap->total_pmds, ap->skipped_pmds,
+		ap->total_pmds ? (ap->skipped_pmds * 100) / ap->total_pmds : 0,
+		ap->scan_round, ap->force_scan ? "true" : "false");
+}
+
 static void work_func(struct work_struct *work)
 {
 	int ret = 0;
@@ -514,9 +522,9 @@ static void work_func(struct work_struct *work)
 			if (ap->force_scan)
 				reset_bloom_filter(ap);
 			ap->scan_round++;
+			ap->total_pmds = 0;
+			ap->skipped_pmds = 0;
 		}
-		ap->total_pmds = 0;
-		ap->skipped_pmds = 0;
 	}
 
 	if (access_pid_cur_last_scanning(ap))
@@ -559,11 +567,8 @@ static void work_func(struct work_struct *work)
 
 	/* Print bloom filter stats at end of each scan round */
 	if (ap->type == NORMAL_SCAN && enable_bloom_filter &&
-	    ap->cur_times >= ap->ntimes) {
-		pr_info("[bloom_filter] pid=%d total_pmd=%llu skipped_pmd=%llu scan_round=%u force=%s\n",
-			ap->pid, ap->total_pmds, ap->skipped_pmds,
-			ap->scan_round, ap->force_scan ? "true" : "false");
-	}
+	    ap->cur_times >= ap->ntimes)
+		log_bloom_stats(ap);
 
 	if (ap->cur_times < ap->ntimes) {
 		queue_delayed_work(adev->scanq, &ap->scan_work,
-- 

-/* Access-frequency counter: bits [5..15] (11 bits) */
-#define SMAP_ACC_CNT_SHIFT    (SMAP_INIT_FLAG_SHIFT + 1)
-#define SMAP_ACC_CNT_WIDTH    11
-#define SMAP_ACC_CNT_MASK     ((1UL << SMAP_ACC_CNT_WIDTH) - 1)
-#define SMAP_ACC_CNT_MAX      SMAP_ACC_CNT_MASK /* 0x7FF = 2047, sentinel */
+#define SMAP_COLD_FIELD_MASK   (SMAP_COLD_PERIOD_MASK << LAST_CPUPID_PGSHIFT)
 
-/* Field-local masks (already shifted to LAST_CPUPID_PGSHIFT origin). */

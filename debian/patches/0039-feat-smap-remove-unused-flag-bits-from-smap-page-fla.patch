-	(SMAP_ACC_CNT_MASK << SMAP_ACC_CNT_SHIFT)
+/* Init flag: bit [4]. 1 = kernel-uninitialised, 0 = SMAP-seen. */
+#define SMAP_INIT_FLAG_SHIFT   (LAST_CPUPID_PGSHIFT + SMAP_COLD_PERIOD_WIDTH)
+#define SMAP_INIT_FLAG_MASK    (1UL << SMAP_INIT_FLAG_SHIFT)
 
-/**
- * smap_page_cold_periods_get - Read the consecutive-cold-period counter
- *
- * @page: target page
- *
- * Returns a value 0..14: how many consecutive periods (ending with the
- * most-recently-completed period) this page had zero access frequency.
- *
- * SMAP_COLD_PERIOD_MASK (0xF, all-1s) is reserved as a sentinel meaning

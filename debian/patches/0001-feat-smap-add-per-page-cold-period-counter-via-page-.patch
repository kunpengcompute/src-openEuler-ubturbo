-	if (access_pid_cur_last_scanning(ap))
+	/*
+	 * Resolve actc_data once so we can reuse the entry for both
+	 * access recording and end-of-period cold-period update.
+	 */
+	if (is_young || access_pid_cur_last_scanning(ap))
+		entry = actc_data_lookup_entry(paddr, g_pagesize_huge);
+
+	if (is_young && entry)
+		(*entry)++;
+
+	if (access_pid_cur_last_scanning(ap)) {
 		add_to_bm_huge(host_va, paddr, ap);
+		/*
+		 * End of period: update cold-period counter from
+		 * accumulated actc_data.
+		 */
+		if (entry) {
+			page = pfn_to_online_page(PHYS_PFN(paddr));
+			if (page) {
+				if (*entry > 0)
+					smap_page_cold_periods_reset(page);
+				else
+					smap_page_cold_periods_inc(page);
+			}
+		}
+	}
 
 	return 0;
 }
@@ -1353,6 +1379,8 @@ static const struct mm_walk_ops pte_range_ops = {
 
 static void process_scan_results(struct pte_walk *pte_walk)
 {
+	struct access_tracking_dev *adev;
+	struct page *page;
 	u64 i, pa_idx;
 	int ret;
 	bool is_last_scan;
@@ -1364,6 +1392,9 @@ static void process_scan_results(struct pte_walk *pte_walk)
 
 	for (i = 0; i < pte_walk->scan_result_cnt; i++) {
 		struct scan_result_entry *entry = &pte_walk->scan_results[i];
+
+		cond_resched();
+
 		if (entry->nid < nr_local_numa)
 			ret = calc_paddr_acidx_acpi_known_nid(
 				entry->paddr, entry->nid, &pa_idx, PAGE_SIZE);
@@ -1374,10 +1405,26 @@ static void process_scan_results(struct pte_walk *pte_walk)
 			continue;
 		if (entry->hot)
 			actc_data_update(entry->nid, pa_idx);
-		if (is_last_scan)
-			add_to_bm_page_fast(entry->paddr, entry->nid, pa_idx,
-					    pte_walk->ap);
-		cond_resched();
+		if (!is_last_scan)
+			continue;
+
+		add_to_bm_page_fast(entry->paddr, entry->nid, pa_idx,
+				    pte_walk->ap);
+		/*
+		 * End of period: update cold-period counter from
+		 * accumulated actc_data (reuse already-computed pa_idx).
+		 */
+		adev = get_access_tracking_dev(entry->nid);
+		if (!adev || pa_idx >= adev->page_count || adev->is_hist)
+			continue;
+
+		page = pfn_to_online_page(PHYS_PFN(entry->paddr));
+		if (!page)
+			continue;
+		if (adev->access_bit_actc_data[pa_idx] > 0)
+			smap_page_cold_periods_reset(page);
+		else
+			smap_page_cold_periods_inc(page);
 	}
 }
 
diff --git a/plugins/smap/src/drivers/smap_page_flags.h b/plugins/smap/src/drivers/smap_page_flags.h
new file mode 100644
index 0000000..fb90c7f
--- /dev/null
+++ b/plugins/smap/src/drivers/smap_page_flags.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
+ * Description: SMAP page->flags helpers for cold-period tracking
+ *
+ * On aarch64 the LAST_CPUPID field in page->flags is unused when NUMA
+ * balancing is disabled. We repurpose the least-significant 4 bits to
+ * store a consecutive-cold-period counter.
+ */
+
+#ifndef _SRC_SMAP_PAGE_FLAGS_H
+#define _SRC_SMAP_PAGE_FLAGS_H
+
+#include <linux/bits.h>
+#include <linux/compiler.h> /* for READ_ONCE */
+#include <linux/mmzone.h> /* for NR_PAGEFLAGS, SECTIONS/NODES/ZONES_WIDTH */
+#include <asm/cmpxchg.h>
+
+#define SMAP_COLD_PERIOD_WIDTH 4
+#define SMAP_COLD_PERIOD_MASK ((1UL << SMAP_COLD_PERIOD_WIDTH) - 1)
+#define SMAP_COLD_PERIOD_MAX 16
+
+/**
+ * smap_page_cold_periods_get - Read the consecutive-cold-period counter
+ *
+ * @page: target page
+ *
+ * Returns a value 0..14: how many consecutive periods (ending with the
+ * most-recently-completed period) this page had zero access frequency.
+ *
+ * SMAP_COLD_PERIOD_MASK (0xF, all-1s) is reserved as a sentinel meaning
+ * "uninitialized" — the kernel sets LAST_CPUPID to all-1s when a page is
+ * freed, so returning 0xF would falsely flag a freshly-allocated page as
+ * extremely cold.  See smap_page_cold_periods_inc for details.
+ */
+static inline u8 smap_page_cold_periods_get(struct page *page)
+{
+	u8 cnt = (page->flags >> LAST_CPUPID_PGSHIFT) & SMAP_COLD_PERIOD_MASK;
+
+	/* all-1s (0xF) = kernel-initialised / never touched by SMAP → 0 */
+	return (cnt == SMAP_COLD_PERIOD_MASK) ? 0 : cnt;
+}
+
+/**
+ * smap_page_cold_periods_reset - Reset the cold-period counter to 0
+ *
+ * @page: target page
+ *
+ * Call when the page was accessed during the current period.
+ */
+static inline void smap_page_cold_periods_reset(struct page *page)
+{
+	unsigned long old, new;
+
+	do {
+		old = READ_ONCE(page->flags);
+		new = old;
+		new &= ~(LAST_CPUPID_MASK << LAST_CPUPID_PGSHIFT);
+	} while (unlikely(cmpxchg(&page->flags, old, new) != old));
+}
+
+/**
+ * smap_page_cold_periods_inc - Increment the cold-period counter (saturating)
+ *
+ * @page: target page
+ *
+ * Call at period end when the page was NOT accessed the entire period.
+ */
+static inline void smap_page_cold_periods_inc(struct page *page)
+{
+	unsigned long old, new;
+	u8 cnt;
+
+	do {
+		old = READ_ONCE(page->flags);
+		cnt = (old >> LAST_CPUPID_PGSHIFT) & SMAP_COLD_PERIOD_MASK;
+		if (cnt == SMAP_COLD_PERIOD_MASK)
+			cnt = 1;
+		else if (cnt < SMAP_COLD_PERIOD_MAX)
+			cnt++;
+		new = old;
+		new &= ~(LAST_CPUPID_MASK << LAST_CPUPID_PGSHIFT);
+		new |= ((unsigned long)cnt<< LAST_CPUPID_PGSHIFT);
+	} while (unlikely(cmpxchg(&page->flags, old, new) != old));
+
+	return cnt;
+}
+
+#endif /* _SRC_SMAP_PAGE_FLAGS_H */

-		adev->access_bit_actc_data[pa_index]++;
-}
-
-static void actc_data_add_fast(phys_addr_t paddr, u32 page_size)
+/*
+ * Common lookup: resolve paddr → &actc_data[pa_index].
+ * Returns NULL for non-local, non-tracked, or histogram pages.
+ */
+static actc_t *actc_data_lookup_entry(phys_addr_t paddr, u32 page_size)
 {
 	struct access_tracking_dev *adev;
 	int ret, nid;
@@ -384,23 +379,31 @@ static void actc_data_add_fast(phys_addr_t paddr, u32 page_size)
 
 	nid = get_numa_id_by_paddr(paddr);
 	if (unlikely(nid == NUMA_NO_NODE))
-		return;
+		return NULL;
 
-	if (nid < nr_local_numa) {
+	if (nid < nr_local_numa)
 		ret = calc_paddr_acidx_acpi_known_nid(paddr, nid, &pa_index,

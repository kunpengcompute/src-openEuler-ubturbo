diff --git a/plugins/smap/src/drivers/smap_cold_queue.c b/plugins/smap/src/drivers/smap_cold_queue.c
new file mode 100644
index 0000000..5035b89
--- /dev/null
+++ b/plugins/smap/src/drivers/smap_cold_queue.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
+ * Description: Per-node PFN queue for cold page swap-out
+ *
+ * Provides the per-node circular buffer and enqueue function used by the
+ * scan path (accessed_bit.c).  Only remote (slow-tier) cold pages are
+ * enqueued.  The drain function lives in the tiering module (mig_init.c)
+ * which has access to reclaim_pages.
+ */
+
+#include <linux/kernel.h>
+#include <linux/slab.h>
+#include <linux/mm.h>
+#include <linux/string.h>
+#include <linux/vmalloc.h>
+
+#include "smap_cold_queue.h"
+
+/* Per-node queues (local + remote) */
+struct smap_cold_queue smap_cold_numa_queue[SMAP_MAX_NUMNODES];
+EXPORT_SYMBOL(smap_cold_numa_queue);
+
+void smap_cold_queue_free(void)
+{
+	int i;
+
+	for (i = 0; i < SMAP_MAX_NUMNODES; i++) {
+		struct smap_cold_queue *q = &smap_cold_numa_queue[i];
+		vfree(q->pfn);
+		q->pfn = NULL;
+	}
+}
+
+int smap_cold_queue_init(void)
+{
+	int ret = 0;
+	int i;
+
+	for (i = 0; i < SMAP_MAX_NUMNODES; i++) {
+		struct smap_cold_queue *q = &smap_cold_queues[i];
+
+		q->pfn = vmalloc(SMAP_COLD_QUEUE_MAX_SIZE * sizeof(u64),
+				 GFP_KERNEL);
+		if (!q->pfn) {
+			smap_cold_queue_free();
+			ret = -ENOMEM;
+			break;
+		}
+		q->head = 0;
+		q->tail = 0;
+		q->count = 0;
+	}
+	return ret;
+}
+
+int smap_cold_queue_enqueue(int nid, u64 pfn)
+{
+	struct smap_cold_queue *q;
+	unsigned long flags;
+
+	if (nid < 0 || nid >= SMAP_MAX_NUMNODES)
+		return -1;
+
+	q = &smap_cold_numa_queue[nid];
+	spin_lock_irqsave(&smap_cold_pid_lock, flags);
+	if (q->count >= SMAP_COLD_QUEUE_MAX_SIZE) {
+		spin_unlock_irqrestore(&smap_cold_pid_lock, flags);
+		return -1;
+	}
+
+	q->pfn[q->tail] = pfn;
+	q->tail = (q->tail + 1) & SMAP_COLD_QUEUE_MAX_MASK;
+	q->count++;
+	spin_unlock_irqrestore(&smap_cold_pid_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL(smap_cold_queue_enqueue);
diff --git a/plugins/smap/src/drivers/smap_cold_queue.h b/plugins/smap/src/drivers/smap_cold_queue.h
new file mode 100644
index 0000000..71e8dbb
--- /dev/null
+++ b/plugins/smap/src/drivers/smap_cold_queue.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) Huawei Technologies Co., Ltd. 2024-2024. All rights reserved.
+ * Description: Per-node PFN queue for cold page swap-out
+ *
+ * During the scan phase, pages whose consecutive-cold-period counter crosses
+ * SMAP_COLD_PERIOD_THRESHOLD are enqueued here.
+ */
+
+#ifndef _SRC_SMAP_COLD_QUEUE_H
+#define _SRC_SMAP_COLD_QUEUE_H
+
+#define SMAP_COLD_QUEUE_MAX_SIZE (262144 * 16) /* 2^18 */
+#define SMAP_COLD_QUEUE_MAX_MASK (SMAP_COLD_QUEUE_MAX_SIZE - 1)
+
+#ifndef SMAP_MAX_NUMNODES
+#define SMAP_MAX_NUMNODES 22
+#endif
+
+struct smap_cold_queue {
+	u64 *pfn;
+	unsigned int head; /* next dequeue index */
+	unsigned int tail; /* next enqueue index */
+	unsigned int count; /* current number of entries */
+};
+
+/*
+ * One queue per NUMA node (local + remote).
+ * Defined in smap_cold_queue.c (drivers module).
+ */
+extern struct smap_cold_queue smap_cold_numa_queue[SMAP_MAX_NUMNODES];
+
+void smap_cold_queue_free(void);
+int smap_cold_queue_init(void);
+
+int smap_cold_queue_enqueue(int nid, u64 pfn);
+
+#endif /* _SRC_SMAP_COLD_QUEUE_H */
diff --git a/plugins/smap/src/drivers/smap_page_flags.h b/plugins/smap/src/drivers/smap_page_flags.h
index fb90c7f..1b6b7e3 100644
--- a/plugins/smap/src/drivers/smap_page_flags.h
+++ b/plugins/smap/src/drivers/smap_page_flags.h
@@ -65,8 +65,21 @@ static inline void smap_page_cold_periods_reset(struct page *page)
  * @page: target page
  *
  * Call at period end when the page was NOT accessed the entire period.
+ * Returns the new counter value (0..14).  Only touches the low 4 bits.
+ *
+ * The all-1s pattern SMAP_COLD_PERIOD_MASK (0xF = 15) is reserved as a
+ * sentinel for "page never touched by SMAP".  The kernel sets the
+ * LAST_CPUPID field to all-1s when a page is freed/released, so without
+ * this sentinel every freshly-allocated page would appear to have cold
+ * count 15 and be immediately enqueued for swap-out on first scan.
+ *
+ * Effective counter range is therefore 0..14.  Saturates at 14: once a
+ * page has been cold for 14+ periods it stays at the cap so it is retried
+ * for swap-out every period.  Since g_cold_period_threshold is clamped to
+ * [1, 15], a cap of 14 still triggers swap-out at any valid threshold
+ * (14 >= threshold for threshold <= 14).
  */
-static inline void smap_page_cold_periods_inc(struct page *page)
+static inline u8 smap_page_cold_periods_inc(struct page *page)
 {
 	unsigned long old, new;
 	u8 cnt;
@@ -75,9 +88,10 @@ static inline void smap_page_cold_periods_inc(struct page *page)
 		old = READ_ONCE(page->flags);
 		cnt = (old >> LAST_CPUPID_PGSHIFT) & SMAP_COLD_PERIOD_MASK;
 		if (cnt == SMAP_COLD_PERIOD_MASK)
-			cnt = 1;
-		else if (cnt < SMAP_COLD_PERIOD_MAX)
-			cnt++;
+			cnt = 1;  /* sentinel: kernel all-1s / uninitialised */
+		else if (cnt < SMAP_COLD_PERIOD_MASK - 1)
+			cnt++;    /* saturate at 14, keep 0xF as sentinel */
+		/* else: cnt == 14, stay at cap. */
 		new = old;
 		new &= ~(LAST_CPUPID_MASK << LAST_CPUPID_PGSHIFT);
 		new |= ((unsigned long)cnt<< LAST_CPUPID_PGSHIFT);
@@ -86,4 +100,10 @@ static inline void smap_page_cold_periods_inc(struct page *page)
 	return cnt;
 }
 
+/*
+ * Threshold for triggering cold-page swap-out.  When a page's consecutive
+ * cold-period counter reaches this value, it is enqueued for reclaim.
+ */
+#define SMAP_COLD_PERIOD_THRESHOLD 10
+
 #endif /* _SRC_SMAP_PAGE_FLAGS_H */

diff --git a/plugins/smap/src/drivers/accessed_bit.c b/plugins/smap/src/drivers/accessed_bit.c
index 68d490d..3cd00a7 100644
--- a/plugins/smap/src/drivers/accessed_bit.c
+++ b/plugins/smap/src/drivers/accessed_bit.c
@@ -21,6 +21,8 @@
 #include <linux/pid_namespace.h>
 #include <linux/pid.h>
 #include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
 #include <linux/slab.h>
 #include <linux/sched/mm.h>
 #include <linux/sched/signal.h>
@@ -240,6 +242,84 @@ static const struct proc_ops proc_file_ops = {
 	.proc_read = proc_file_read,
 };
 
+/*
+ * Runtime-tunable cold-period threshold, exposed at
+ * /proc/smap/cold_period_threshold. Default 10 (matches the old compile-time
+ * SMAP_COLD_PERIOD_THRESHOLD). Write a positive integer to adjust at runtime;
+ * read with cat. No lock: the 32-bit aligned read/write is atomic, and a
+ * torn read of a soft threshold is harmless.
+ */
+unsigned int g_cold_period_threshold = 10;
+EXPORT_SYMBOL(g_cold_period_threshold);
+
+#define SMAP_COLD_PERIOD_THRESHOLD_MIN 1
+#define SMAP_COLD_PERIOD_THRESHOLD_MAX 15
+
+static ssize_t cold_threshold_proc_read(struct file *file, char __user *buf,
+					 size_t count, loff_t *ppos)
+{
+	char kbuf[16];
+	int len;
+
+	/* Single unsigned int; EOF once served. */
+	if (*ppos > 0)
+		return 0;
+	len = snprintf(kbuf, sizeof(kbuf), "%u\n", g_cold_period_threshold);
+	if (len < 0 || count < (size_t)len)
+		return -EINVAL;
+	if (copy_to_user(buf, kbuf, len))
+		return -EFAULT;
+	*ppos += len;
+	return len;
+}
+
+static ssize_t cold_threshold_proc_write(struct file *file,
+					 const char __user *buf, size_t count,
+					 loff_t *pos)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint_from_user(buf, count, DECIMAL, &val);
+	if (ret)
+		return ret;
+	if (val < SMAP_COLD_PERIOD_THRESHOLD_MIN ||
+	    val > SMAP_COLD_PERIOD_THRESHOLD_MAX) {
+		pr_err("cold_period_threshold %u out of range [%d, %d]\n", val,
+		       SMAP_COLD_PERIOD_THRESHOLD_MIN,
+		       SMAP_COLD_PERIOD_THRESHOLD_MAX);
+		return -EINVAL;
+	}
+	WRITE_ONCE(g_cold_period_threshold, val);
+	return count;
+}
+
+static const struct proc_ops cold_threshold_fops = {
+	.proc_read = cold_threshold_proc_read,
+	.proc_write = cold_threshold_proc_write,
+};
+
+/* Register /proc/smap/cold_period_threshold. Must run after access_ioctl_init
+ * has created smap_procfs_root. Failure is non-fatal: the threshold keeps its
+ * default and the scan path still works, only runtime tuning is unavailable. */
+int smap_cold_threshold_proc_init(void)
+{
+	struct proc_dir_entry *pde;
+
+	if (!smap_procfs_root) {
+		pr_err("smap procfs root not ready, skip cold_period_threshold\n");
+		return -ENXIO;
+	}
+	pde = proc_create("cold_period_threshold", 0644, smap_procfs_root,
+			  &cold_threshold_fops);
+	if (!pde) {
+		pr_err("failed to create /proc/smap/cold_period_threshold\n");
+		return -ENOMEM;
+	}
+	proc_set_user(pde, procfs_kuid, procfs_kgid);
+	return 0;
+}
+
 int smap_create_tracking_info_file(struct ham_tracking_info *info)
 {
 	int ret;
@@ -487,7 +567,7 @@ static int hva_to_hpa_hugetlb(struct kvm *kvm, u64 host_va,
 			int cold_nid = pfn_to_nid(PHYS_PFN(paddr));
 
 			if (smap_page_cold_periods_inc(page) >=
-				    SMAP_COLD_PERIOD_THRESHOLD &&
+				    g_cold_period_threshold &&
 			    cold_nid >= nr_local_numa)
 				smap_cold_queue_enqueue(cold_nid,
 							PHYS_PFN(paddr));
@@ -631,7 +711,7 @@ static int hva_to_hpa_4k(struct kvm *kvm, u64 host_va, struct access_pid *ap,
 			int cold_nid = pfn_to_nid(PHYS_PFN(paddr));
 
 			if (smap_page_cold_periods_inc(page) >=
-				    SMAP_COLD_PERIOD_THRESHOLD &&
+				    g_cold_period_threshold &&
 			    !smap_cold_queue_enqueue(cold_nid, PHYS_PFN(paddr))) {
 				/* enqueued into cold_queue; skip bitmap */
 			} else {
@@ -927,7 +1007,7 @@ static int process_memslot_pages(struct kvm *kvm,
 					int cold_nid = pfn_to_nid(PHYS_PFN(paddr));
 
 					if (smap_page_cold_periods_inc(page) >=
-						    SMAP_COLD_PERIOD_THRESHOLD &&
+						    g_cold_period_threshold &&
 					    !smap_cold_queue_enqueue(cold_nid,
 								     PHYS_PFN(paddr))) {
 					/* enqueued into cold_queue; skip bitmap */
@@ -1683,7 +1763,7 @@ static void process_scan_results(struct pte_walk *pte_walk)
 			smap_page_cold_periods_reset(page);
 		else if (entry->nid >= nr_local_numa &&
 			 smap_page_cold_periods_inc(page) >=
-				 SMAP_COLD_PERIOD_THRESHOLD)
+				 g_cold_period_threshold)
 			smap_cold_queue_enqueue(entry->nid, PHYS_PFN(entry->paddr));
 		put_page(page);
 	}

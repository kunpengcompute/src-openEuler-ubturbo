-                              remoteNid - nrLocalNuma,
-                              attr->strategyAttr.allocRemoteNrPages[l1Nid[i]][remoteNid - nrLocalNuma]);
+    if (l1Len == 0) {
+        SMAP_LOGGER_WARNING("Aborted alloc account rebuild for pid %d due to missing L1 node", attr->pid);
+        return;
+    }

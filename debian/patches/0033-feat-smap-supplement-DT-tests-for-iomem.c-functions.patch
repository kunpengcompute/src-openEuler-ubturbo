+    mr.start = 0xFF;
+    mr.end = 0x0;
+
+    list_add(&mr.node, &obmm_dev.list);
+    int ret = find_range_by_memid(1, &start, &end);
+    EXPECT_EQ(-ENOENT, ret);
+
+    list_del(&mr.node);
+}
+
+TEST_F(IomemTest, FindRangeByMemidStartEqualsEnd)
+{
+    u64 start, end;
+    free_obmm_dev();
+
+    struct memid_range mr;
+    mr.memid = 1;
+    mr.start = 0x1000;
+    mr.end = 0x1000;
+
+    list_add(&mr.node, &obmm_dev.list);
+    int ret = find_range_by_memid(1, &start, &end);
+    EXPECT_EQ(-ENOENT, ret);
+

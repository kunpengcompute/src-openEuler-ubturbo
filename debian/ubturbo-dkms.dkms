PACKAGE_NAME="ubturbo-dkms"
PACKAGE_VERSION="1.0.0"
AUTOINSTALL="yes"
BUILD_EXCLUSIVE_KERNEL="^6.6.*"

MAKE[0]="make KERNELDIR=/lib/modules/${kernelver}/build modules"
CLEAN="make KERNELDIR=/lib/modules/${kernelver}/build clean"

BUILT_MODULE_NAME[0]="smap_tracking_core"
BUILT_MODULE_LOCATION[0]="drivers"
DEST_MODULE_LOCATION[0]="/updates"

BUILT_MODULE_NAME[1]="smap_access_tracking"
BUILT_MODULE_LOCATION[1]="drivers"
DEST_MODULE_LOCATION[1]="/updates"

BUILT_MODULE_NAME[2]="smap_histogram_tracking"
BUILT_MODULE_LOCATION[2]="drivers"
DEST_MODULE_LOCATION[2]="/updates"

BUILT_MODULE_NAME[3]="smap_tiering"
BUILT_MODULE_LOCATION[3]="tiering"
DEST_MODULE_LOCATION[3]="/updates"

BUILT_MODULE_NAME[4]="ucache"
BUILT_MODULE_LOCATION[4]="ucache"
DEST_MODULE_LOCATION[4]="/updates"

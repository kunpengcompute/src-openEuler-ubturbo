#!/bin/sh
set -e

# ubturbo-rmrs postinst -- create user/group, install service, set permissions.
# Mirrors RPM spec %post rmrs.
LOG_DIR="/var/log/ubturbo"
LOG_FILE="$LOG_DIR/ubturbo-install.log"
PROGRAM_DIR="/opt/ubturbo"
PROGRAM_CONF_DIR="/opt/ubturbo/conf"
PROGRAM_LIB_DIR="/opt/ubturbo/lib"
PROGRAM_BIN_DIR="/opt/ubturbo/bin"
PROGRAM_LOG_DIR="/var/log/ubturbo"
SYSTEM_USER="ubturbo"
SYSTEM_GROUP="ubturbo"

log_message() {
    log_type="$1"
    message="$2"
    if [ ! -d "$LOG_DIR" ]; then
        mkdir -p "$LOG_DIR" || return 0
        chmod 700 "$LOG_DIR" || return 0
    fi
    printf '[%s] [%s] %s\n' "$(date)" "$log_type" "$message" >> "$LOG_FILE" 2>/dev/null || true
}

case "$1" in
    configure)
        log_message INFO "post_install.sh started"

        # Create system group (idempotent).
        if ! getent group "$SYSTEM_GROUP" >/dev/null 2>&1; then
            groupadd -r "$SYSTEM_GROUP"
            log_message INFO "Group $SYSTEM_GROUP created"
        fi

        # Create system user (idempotent).
        if ! getent passwd "$SYSTEM_USER" >/dev/null 2>&1; then
            useradd -r -g "$SYSTEM_GROUP" -s /usr/sbin/nologin "$SYSTEM_USER"
            log_message INFO "User $SYSTEM_USER created"
        fi

        # Install systemd unit shipped under /opt/ubturbo/scripts/.
        if [ -f "$PROGRAM_DIR/scripts/ubturbo.service" ]; then
            install -m 0644 "$PROGRAM_DIR/scripts/ubturbo.service" \
                /etc/systemd/system/ubturbo.service
            rm -f "$PROGRAM_DIR/scripts/ubturbo.service"
            rmdir "$PROGRAM_DIR/scripts" 2>/dev/null || true
        fi

        # Expose the client library on the multiarch path expected by
        # consumers. Prefer /usr/lib64 for parity with the RPM, fall back
        # to the Debian multiarch directory.
        if [ -f "$PROGRAM_LIB_DIR/libubturbo_client.so" ]; then
            if [ -d /usr/lib64 ]; then
                target=/usr/lib64/libubturbo_client.so
            else
                target=/usr/lib/aarch64-linux-gnu/libubturbo_client.so
            fi
            install -d -m 0755 "$(dirname "$target")"
            install -m 0755 "$PROGRAM_LIB_DIR/libubturbo_client.so" "$target"
            chown "$SYSTEM_USER:$SYSTEM_GROUP" "$target" 2>/dev/null || true
        fi

        # Install the privileged helper and its sudoers fragment. The
        # sudoers file must be 0440 by Debian policy.
        if [ -f "$PROGRAM_BIN_DIR/cat.sh" ]; then
            install -d /usr/local/bin
            install -m 0755 "$PROGRAM_BIN_DIR/cat.sh" /usr/local/bin/cat.sh
            chown root:root /usr/local/bin/cat.sh
            install -d /etc/sudoers.d
            printf 'ubturbo ALL=(root) NOPASSWD:/usr/local/bin/cat.sh\n' \
                > /etc/sudoers.d/ubturbo
            chmod 0440 /etc/sudoers.d/ubturbo
        fi

        # Reload systemd so the freshly-installed unit is picked up.
        systemctl daemon-reload || true

        # Ownership and permissions for runtime directories.
        chown -R "$SYSTEM_USER:$SYSTEM_GROUP" "$PROGRAM_LOG_DIR" 2>/dev/null || true
        chown -R "$SYSTEM_USER:$SYSTEM_GROUP" "$PROGRAM_DIR" 2>/dev/null || true

        chmod 750 "$PROGRAM_DIR" 2>/dev/null || true
        chmod 700 "$PROGRAM_CONF_DIR" 2>/dev/null || true
        chmod 750 "$PROGRAM_LIB_DIR" 2>/dev/null || true
        chmod 750 "$PROGRAM_BIN_DIR" 2>/dev/null || true
        chmod 700 "$PROGRAM_LOG_DIR" 2>/dev/null || true

        if ls "$PROGRAM_CONF_DIR"/*.conf >/dev/null 2>&1; then
            chmod 640 "$PROGRAM_CONF_DIR"/*.conf
        fi
        if ls "$PROGRAM_BIN_DIR"/* >/dev/null 2>&1; then
            chmod 750 "$PROGRAM_BIN_DIR"/*
        fi
        if ls "$PROGRAM_LIB_DIR"/* >/dev/null 2>&1; then
            chmod 640 "$PROGRAM_LIB_DIR"/*
        fi

        # Enable autostart. Failure here is non-fatal (e.g., in a chroot).
        systemctl enable ubturbo.service 2>/dev/null || true

        log_message INFO "post_install.sh ended"
        ;;
esac

#DEBHELPER#

exit 0

#!/bin/sh
set -e

# ubturbo-rmrs postinst -- create user/group, set runtime permissions.
# Mirrors RPM spec %post rmrs.
# Service enable/start/stop is handled by dh_installsystemd via the
# debhelper token at the end of this file (unit ships in
# /usr/lib/systemd/system/).
LOG_DIR="/var/log/ubturbo"
LOG_FILE="$LOG_DIR/ubturbo-install.log"
SYSTEM_USER="ubturbo"
SYSTEM_GROUP="ubturbo"

log_message() {
    log_type="$1"
    message="$2"
    if [ ! -d "$LOG_DIR" ]; then
        mkdir -p "$LOG_DIR" || return 0
        chmod 700 "$LOG_DIR" || return 0
    fi
    printf '[%s] [%s] %s\n' "$(date)" "$log_type" "$message" >> "$LOG_FILE" 2>/dev/null || true
}

case "$1" in
    configure)
        log_message INFO "post_install.sh started"

        # Create system group (idempotent).
        if ! getent group "$SYSTEM_GROUP" >/dev/null 2>&1; then
            groupadd -r "$SYSTEM_GROUP"
            log_message INFO "Group $SYSTEM_GROUP created"
        fi

        # Create system user (idempotent).
        if ! getent passwd "$SYSTEM_USER" >/dev/null 2>&1; then
            useradd -r -g "$SYSTEM_GROUP" -s /usr/sbin/nologin "$SYSTEM_USER"
            log_message INFO "User $SYSTEM_USER created"
        fi

        # Runtime directory only: /var/log/ubturbo (not packaged). The
        # IPC unix socket lives in /run/ubturbo, created and owned by
        # systemd via the unit's RuntimeDirectory=ubturbo.
        # Packaged files under /usr and /etc keep the default dpkg
        # ownership/permissions (root:root, 0755 binaries, 0644
        # libraries and conffiles, see Debian policy 10.x / spec 7c) --
        # dh_fixperms already set them, no chown/chmod here.
        mkdir -p "$LOG_DIR"
        chown "$SYSTEM_USER:$SYSTEM_GROUP" "$LOG_DIR"
        chmod 700 "$LOG_DIR"

        # Privileged helper: sudoers fragment for /usr/libexec/ubturbo/cat
        # (installed without the .sh extension per Debian conventions; it
        # is a sudo-gated helper, not an interactive tool). The sudoers
        # file must be root-owned 0440 by Debian policy.
        if [ -f /usr/libexec/ubturbo/cat ]; then
            install -d /etc/sudoers.d
            printf 'ubturbo ALL=(root) NOPASSWD:/usr/libexec/ubturbo/cat\n' \
                > /etc/sudoers.d/ubturbo
            chmod 0440 /etc/sudoers.d/ubturbo
        fi

        log_message INFO "post_install.sh ended"
        ;;
esac

#DEBHELPER#

exit 0

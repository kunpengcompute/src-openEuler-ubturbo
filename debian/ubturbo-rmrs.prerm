#!/bin/sh
set -e

# ubturbo-rmrs prerm -- stop service before package removal.
# Mirrors RPM spec %preun rmrs.
# The stop/disable/reset-failed and daemon-reload logic is generated by
# dh_installsystemd into the debhelper token at the end of this file.
LOG_DIR="/var/log/ubturbo"
LOG_FILE="$LOG_DIR/ubturbo-uninstall.log"

log_message() {
    log_type="$1"
    message="$2"
    if [ ! -d "$LOG_DIR" ]; then
        mkdir -p "$LOG_DIR" || return 0
    fi
    printf '[%s] [%s] %s\n' "$(date)" "$log_type" "$message" >> "$LOG_FILE" 2>/dev/null || true
}

case "$1" in
    remove)
        log_message INFO "pre_uninstall.sh started"
        # Remove the legacy unit location used by older installs
        # (dh_installsystemd owns /usr/lib/systemd/system/ubturbo.service).
        rm -f /etc/systemd/system/ubturbo.service
        log_message INFO "pre_uninstall.sh ended"
        ;;
esac

#DEBHELPER#

exit 0

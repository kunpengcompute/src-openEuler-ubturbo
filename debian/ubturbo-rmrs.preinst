#!/bin/sh
set -e

# ubturbo-rmrs preinst -- stop service before upgrade/install.
# Mirrors RPM spec %pre rmrs.
# Uses deb-systemd-invoke (init-system-helpers) instead of calling
# systemctl directly, per Debian policy for maintainer scripts.
LOG_DIR="/var/log/ubturbo"
LOG_FILE="$LOG_DIR/ubturbo-install.log"

log_message() {
    log_type="$1"
    message="$2"
    if [ ! -d "$LOG_DIR" ]; then
        mkdir -p "$LOG_DIR" || return 0
        chmod 700 "$LOG_DIR" || return 0
    fi
    printf '[%s] [%s] %s\n' "$(date)" "$log_type" "$message" >> "$LOG_FILE" 2>/dev/null || true
}

case "$1" in
    install|upgrade)
        log_message INFO "pre_install.sh started"
        # Stop any running instance before files are replaced. No-op when
        # the unit or systemd is absent (fresh install, chroot).
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop ubturbo.service >/dev/null 2>&1 || true
        fi
        log_message INFO "pre_install.sh ended"
        ;;
esac

#DEBHELPER#

exit 0

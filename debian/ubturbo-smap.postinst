#!/bin/sh
set -e

# ubturbo-smap postinst -- reload udev so the shipped rule takes effect.
# Kernel modules are provided by ubturbo-dkms and built/installed by DKMS;
# this package only ships the userspace library and the udev rule.

case "$1" in
    configure)
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules 2>/dev/null || true
            udevadm trigger 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0

#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all,-format

NUMJOBS = $(shell nproc)

# DKMS source tree staged for ubturbo-dkms (built on target by DKMS).
DKMS_NAME := ubturbo-dkms
DKMS_VERSION := 1.0.0
DKMS_SRC := $(CURDIR)/debian/tmp/usr/src/$(DKMS_NAME)-$(DKMS_VERSION)

%:
	dh $@ --with dkms

# ---------------------------------------------------------------------------
# Build userspace components only: smap userspace lib, ucache plugin, rmrs.
# Kernel modules (smap drivers/tiering/ucache) are NOT compiled at package
# build time anymore; they are shipped as source in ubturbo-dkms and built on
# the target machine via DKMS on install and on every kernel upgrade.
# Quilt patches from debian/patches/series are applied at source preparation
# time (see build-deb.sh -> dpkg-source --before-build), so rules does not
# touch them.
# ---------------------------------------------------------------------------
override_dh_auto_build:
	# 1. smap userspace (libsmap.so) via cmake. "make install" must run so
	#    that libsmap.so is placed under output/smap/lib/ (the path referenced
	#    by the install step below). Mirrors ubturbo.spec %build for smap.
	cd $(CURDIR)/plugins/smap && \
		cmake -DCMAKE_BUILD_TYPE=Release . && \
		make -j$(NUMJOBS) install

	# 2. rmrs main framework
	cd $(CURDIR) && bash -x build.sh -c

	# 3. ucache userspace plugin
	cd $(CURDIR)/plugins/ucache && bash -x build.sh -c

# ---------------------------------------------------------------------------
# Install everything into per-package DESTDIRs, mirroring the spec %install.
# Do NOT touch the build host's /usr/lib64; the libboundscheck symlink is
# only needed inside the package install tree at runtime, not at build time.
# ---------------------------------------------------------------------------
override_dh_auto_install:
	dh_auto_install

	# ---- ubturbo-dkms: stage kernel module SOURCE for DKMS ----
	# Modules are compiled on target by DKMS. The top-level Makefile
	# (from debian/ubturbo-dkms.makefile) drives drivers -> tiering -> ucache.
	install -d -m 0755 $(DKMS_SRC)/drivers
	install -d -m 0755 $(DKMS_SRC)/tiering
	install -d -m 0755 $(DKMS_SRC)/ucache
	cp -a $(CURDIR)/plugins/smap/src/drivers/. $(DKMS_SRC)/drivers/
	cp -a $(CURDIR)/plugins/smap/src/tiering/. $(DKMS_SRC)/tiering/
	cp -a $(CURDIR)/plugins/smap/src/ucache/.  $(DKMS_SRC)/ucache/
	install -m 0644 $(CURDIR)/debian/ubturbo-dkms.makefile $(DKMS_SRC)/Makefile
	# Drop any stray prebuilt artifacts from the staged source tree.
	find $(DKMS_SRC) -type f \( -name '*.ko' -o -name '*.o' -o -name '*.mod' \
		-o -name '*.mod.c' -o -name 'Module.symvers' -o -name 'modules.order' \) -delete

	# ---- ubturbo-smap (userspace only now) ----
	install -d -m 0755 $(CURDIR)/debian/ubturbo-smap/usr/lib/aarch64-linux-gnu
	install -d -m 0755 $(CURDIR)/debian/ubturbo-smap/etc/udev/rules.d
	install -m 0644 $(CURDIR)/plugins/smap/output/smap/lib/libsmap.so \
		$(CURDIR)/debian/ubturbo-smap/usr/lib/aarch64-linux-gnu/libsmap.so
	install -m 0640 $(CURDIR)/plugins/smap/99-smap.rules \
		$(CURDIR)/debian/ubturbo-smap/etc/udev/rules.d/99-smap.rules

	# ---- ubturbo-rmrs ----
	install -d -m 0755 $(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/bin
	install -d -m 0755 $(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/lib
	install -d -m 0755 $(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/conf
	install -d -m 0755 $(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/scripts
	install -m 0755 $(CURDIR)/dist/release/bin/ub_turbo_exec \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/bin/ub_turbo_exec
	install -m 0755 $(CURDIR)/build/rpm/cat.sh \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/bin/cat.sh
	install -m 0644 $(CURDIR)/dist/release/lib/libubturbo_client.so \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/lib/libubturbo_client.so
	install -m 0644 $(CURDIR)/dist/release/lib/librmrs_ubturbo_plugin.so \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/lib/librmrs_ubturbo_plugin.so
	install -m 0644 $(CURDIR)/dist/release/conf/ubturbo_plugin_admission.conf \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/conf/ubturbo_plugin_admission.conf
	install -m 0644 $(CURDIR)/dist/release/conf/ubturbo.conf \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/conf/ubturbo.conf
	install -m 0644 $(CURDIR)/dist/release/conf/plugin_rmrs.conf \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/conf/plugin_rmrs.conf
	install -m 0644 $(CURDIR)/build/rpm/ubturbo.service \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/scripts/ubturbo.service

	# ---- ubturbo-ucache ----
	install -d -m 0755 $(CURDIR)/debian/ubturbo-ucache/opt/ubturbo/lib
	install -d -m 0755 $(CURDIR)/debian/ubturbo-ucache/opt/ubturbo/conf
	install -m 0644 $(CURDIR)/plugins/ucache/cmake-build-release/lib/libucache_os_turbo_plugin.so \
		$(CURDIR)/debian/ubturbo-ucache/opt/ubturbo/lib/libucache_os_turbo_plugin.so
	install -m 0644 $(CURDIR)/plugins/ucache/cmake-build-release/conf/plugin_turbo_ucache.conf \
		$(CURDIR)/debian/ubturbo-ucache/opt/ubturbo/conf/plugin_turbo_ucache.conf

	# ---- patchelf: set rpath for rmrs binaries/libs (matches spec) ----
	find $(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/lib -name '*.so' \
		-exec patchelf --set-rpath '$$ORIGIN/../lib' {} \;
	patchelf --set-rpath '$$ORIGIN/../lib' \
		$(CURDIR)/debian/ubturbo-rmrs/opt/ubturbo/bin/ub_turbo_exec || true

	# ---- ubturbo-dev ----
	install -d -m 0755 $(CURDIR)/debian/ubturbo-dev/usr/include/ubturbo
	for h in turbo_conf.h turbo_def.h turbo_ipc_client.h turbo_ipc_server.h turbo_logger.h; do \
		install -m 0644 $(CURDIR)/include/$$h \
			$(CURDIR)/debian/ubturbo-dev/usr/include/ubturbo/ ; \
	done
	install -m 0644 $(CURDIR)/src/sdk/include/turbo_serialize.h \
		$(CURDIR)/debian/ubturbo-dev/usr/include/ubturbo/
	install -m 0644 $(CURDIR)/src/sdk/turbo_rmrs_interface.h \
		$(CURDIR)/debian/ubturbo-dev/usr/include/ubturbo/
	install -m 0644 $(CURDIR)/src/sdk/turbo_ucache_interface.h \
		$(CURDIR)/debian/ubturbo-dev/usr/include/ubturbo/
	install -m 0644 $(CURDIR)/src/smap/smap_interface.h \
		$(CURDIR)/debian/ubturbo-dev/usr/include/ubturbo/

# No upstream test suite.
override_dh_auto_test:

# Match RPM spec: %global __strip /bin/true (no stripping)
override_dh_strip:
	@echo "Skipping strip per upstream RPM spec"

#!/bin/sh
set -e

# ubturbo-smap postrm -- clean up the udev rule it shipped.
# Kernel modules and their /lib/modules dirs are owned by ubturbo-dkms/DKMS.

case "$1" in
    remove|purge)
        rm -f /etc/udev/rules.d/99-smap.rules

        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
